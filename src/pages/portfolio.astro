---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import TestimonialCard from "../components/TestimonialCard.astro";

const normalizeValue = (value: string) => value.trim().toLowerCase();

// PORTFOLIO
const companiesRaw = await getCollection("portfolio");

const companies = companiesRaw
  .sort((a, b) => b.data.order - a.data.order)
  .map((item) => ({
    slug: item.slug,
    name: item.data.name,
    category: item.data.category,
    categoryKey: normalizeValue(item.data.category),
    founders: item.data.founders,
    description: item.data.description,
    mission: item.data.mission,
    coInvestors: item.data.coInvestors,
    badgeImage: item.data.badgeImage,
    imageBg: item.data.imageBg,
    image: item.data.image,
    imageTitle: item.data.imageTitle,
    linkedinUrl: item.data.linkedinUrl,
    twitterUrl: item.data.twitterUrl,
    websiteUrl: item.data.websiteUrl,
    jobsUrl: item.data.jobsUrl,
    whyInvestedUrl: item.data.whyInvestedUrl,
    order: item.data.order,
  }));

const categoryMap = new Map<string, string>();

companies.forEach((company) => {
  if (!categoryMap.has(company.categoryKey)) {
    categoryMap.set(company.categoryKey, company.category);
  }
});

const filters = ["all", ...categoryMap.keys()];
const filterLabels = Object.fromEntries([
  ["all", "All"],
  ...Array.from(categoryMap.entries()),
]);

// TESTIMONIALS
const testimonialsRaw = await getCollection("testimonials");

const testimonials = testimonialsRaw
  .sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0))
  .map((item) => ({
    category: normalizeValue(item.data.category),
    quote: item.data.quote,
    name: item.data.name,
    role: item.data.role,
    company: item.data.company,
    logo: item.data.logo,
    image: item.data.image,
    order: item.data.order ?? 9999,
  }));

const allTestimonials = testimonials.filter((t) => t.category === "all");
const defaultTestimonial = allTestimonials[0] ?? null;
---

<Layout title="Portfolio | BFC">
  <main>
    <section class="container-default py-20 md:py-28">
      <div class="max-w-5xl">
        <h1 class="max-w-4xl text-4xl font-extrabold leading-tight tracking-tight text-slate-900 dark:text-slate-100 md:text-6xl">
          Here are the teams that are
          <br />
          building the future
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">
          We believe in these founders to leave a lasting legacy
        </p>
      </div>
    </section>


    <section class="sticky top-[73px] z-40 border-y border-slate-200 bg-white/90 py-4 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90">
      <div class="container-default flex flex-wrap gap-3">
        {filters.map((filter, index) => (
          <button
            type="button"
            class={`filter-btn rounded-full px-5 py-2 text-sm font-medium transition ${
              index === 0
                ? "bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900"
                : "bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
            }`}
            data-filter={filter}
          >
            {filterLabels[filter]}
          </button>
        ))}
      </div>
    </section>

    <section class="container-default space-y-24 py-12 md:py-16">
      {companies.map((company) => (
        <article
          id={company.slug}
          class="portfolio-item scroll-mt-32 grid items-center gap-10 md:gap-12 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.75fr)]"
          data-category={company.categoryKey}
        >
          <div class={`group relative aspect-[1/1] overflow-hidden rounded-[28px] ${company.imageBg}`}>
            <img
              src={company.image}
              alt={company.name}
              class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]"
            />

            {company.imageTitle && (
              <div class="absolute bottom-8 left-8 max-w-xs text-white">
                <h3 class="text-2xl font-bold leading-tight">{company.imageTitle}</h3>
              </div>
            )}
          </div>

          <div class="space-y-6">
            <div class="flex items-center gap-4">
              <div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-lg bg-white ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800">
                {company.badgeImage ? (
                  <img
                    src={company.badgeImage}
                    alt={`${company.name} logo`}
                    class="h-full w-full object-contain"
                  />
                ) : (
                  <span class="text-xs font-bold text-slate-700 dark:text-slate-200">
                    {company.name.charAt(0)}
                  </span>
                )}
              </div>

              <div>
                <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">{company.name}</h2>
                <p class="text-sm font-medium text-slate-500 dark:text-slate-400">
                  Founders: {company.founders}
                </p>
              </div>
            </div>

            <p class="leading-8 text-slate-600 dark:text-slate-300">
              {company.description}
              {company.whyInvestedUrl && company.whyInvestedUrl !== "#" && (
                <a
                  href={company.whyInvestedUrl}
                  class="ml-1 font-medium text-blue-600 dark:text-blue-400"
                  target="_blank"
                  rel="noreferrer"
                >
                  (Why we invested?)
                </a>
              )}
            </p>

            <div class="grid grid-cols-1 gap-8 pt-4 sm:grid-cols-2">
              <div>
                <p class="mb-2 text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500">
                  MISSION
                </p>
                <p class="text-sm font-medium text-slate-800 dark:text-slate-200">{company.mission}</p>
              </div>

              <div class="flex gap-8 sm:justify-end">
                <div>
                  <p class="mb-2 text-right text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500">
                    CONNECT
                  </p>
                  <div class="flex justify-end gap-3 text-slate-400 dark:text-slate-500">
                    {company.linkedinUrl && company.linkedinUrl !== "#" && (
                      <a
                        href={company.linkedinUrl}
                        class="hover:text-slate-900 dark:hover:text-slate-100"
                        target="_blank"
                        rel="noreferrer"
                      >
                        In
                      </a>
                    )}
                    {company.twitterUrl && company.twitterUrl !== "#" && (
                      <a
                        href={company.twitterUrl}
                        class="hover:text-slate-900 dark:hover:text-slate-100"
                        target="_blank"
                        rel="noreferrer"
                      >
                        X
                      </a>
                    )}
                    {company.websiteUrl && company.websiteUrl !== "#" && (
                      <a
                        href={company.websiteUrl}
                        class="hover:text-slate-900 dark:hover:text-slate-100"
                        target="_blank"
                        rel="noreferrer"
                      >
                        🌐
                      </a>
                    )}
                  </div>
                </div>

                <div>
                  <p class="mb-2 text-right text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500">
                    JOBS
                  </p>
                  {company.jobsUrl && company.jobsUrl !== "#" && (
                    <a
                      href={company.jobsUrl}
                      class="block text-right text-slate-400 hover:text-slate-900 dark:text-slate-500 dark:hover:text-slate-100"
                      target="_blank"
                      rel="noreferrer"
                    >
                      ↗
                    </a>
                  )}
                </div>
              </div>
            </div>

            <div class="border-t border-slate-200 pt-4 dark:border-slate-800">
              <p class="mb-2 text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500">
                CO INVESTORS INCLUDE
              </p>
              <p class="text-xs font-medium text-slate-600 dark:text-slate-300">{company.coInvestors}</p>
            </div>
          </div>
        </article>
      ))}
    </section>

    <section
  id="testimonial-section"
  class={`container-default py-24 ${defaultTestimonial ? "" : "hidden"}`}
>
  <div class="mb-10 max-w-2xl">
    <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 md:text-4xl">
      What our founders say about us
    </h2>
    <p class="mt-3 text-lg text-slate-600 dark:text-slate-300">
      We back founders with conviction and stay close when it matters most.
    </p>
  </div>

  {defaultTestimonial && (
    <TestimonialCard
      id="testimonial-card"
      quote={defaultTestimonial.quote}
      name={defaultTestimonial.name}
      role={defaultTestimonial.role}
      company={defaultTestimonial.company}
      logo={defaultTestimonial.logo}
      image={defaultTestimonial.image}
    />
  )}
</section>
  </main>

  <script is:inline define:vars={{ testimonials }}>
    document.addEventListener("DOMContentLoaded", () => {
      const buttons = document.querySelectorAll(".filter-btn");
      const items = document.querySelectorAll(".portfolio-item");
      const testimonialSection = document.getElementById("testimonial-section");
      const testimonialCard = document.getElementById("testimonial-card");

      let active = "all";

      function getTestimonial(category) {
        const matches = testimonials.filter((t) => t.category === category);
        if (matches.length > 0) {
          return matches[0];
        }
        return null;
      }

      function updateTestimonial(category) {
        if (!testimonialSection || !testimonialCard) return;

        const data = getTestimonial(category);

        if (!data) {
          testimonialSection.classList.add("hidden");
          return;
        }

        testimonialSection.classList.remove("hidden");

        const quote = testimonialCard.querySelector("[data-quote]");
        const name = testimonialCard.querySelector("[data-name]");
        const role = testimonialCard.querySelector("[data-role]");
        const company = testimonialCard.querySelector("[data-company]");
        const logo = testimonialCard.querySelector("[data-logo]");
        const image = testimonialCard.querySelector("[data-image]");

        if (quote) quote.textContent = data.quote;
        if (name) name.textContent = data.name;
        if (role) role.textContent = data.role;
        if (company) company.textContent = data.company ?? "";

        if (logo && data.logo) {
          logo.src = data.logo;
          logo.alt = `${data.company ?? data.name} logo`;
        }

        if (image && data.image) {
          image.src = data.image;
          image.alt = data.name;
        }
      }

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          buttons.forEach((b) => {
            b.classList.remove("bg-slate-900", "text-white", "dark:bg-slate-100", "dark:text-slate-900");
            b.classList.add("bg-slate-100", "text-slate-600", "dark:bg-slate-900", "dark:text-slate-300");
          });

          btn.classList.remove("bg-slate-100", "text-slate-600", "dark:bg-slate-900", "dark:text-slate-300");
          btn.classList.add("bg-slate-900", "text-white", "dark:bg-slate-100", "dark:text-slate-900");

          active = btn.dataset.filter;

          items.forEach((item) => {
            const cat = item.dataset.category;
            item.style.display = active === "all" || cat === active ? "grid" : "none";
          });

          updateTestimonial(active);
        });
      });

      updateTestimonial(active);
    });
  </script>
</Layout>