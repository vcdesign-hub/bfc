---
import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Newsletter | BFC</title>
    <meta
      name="description"
      content="Subscribe to the BFC newsletter for updates on portfolio companies, founder stories, investments, and insights."
    />

    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

      if (storedTheme === 'dark' || (!storedTheme && systemPrefersDark)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen bg-white font-sans text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <main class="min-h-screen bg-white dark:bg-slate-950">
      <section class="min-h-screen">
        <div class="grid min-h-screen overflow-hidden bg-white dark:bg-slate-950 lg:grid-cols-[minmax(0,0.42fr)_minmax(0,0.58fr)]">

          <!-- LEFT -->
          <div class="relative flex flex-col overflow-hidden border-b border-slate-200 bg-slate-950 lg:border-b-0 lg:border-r lg:border-slate-800">

            <div class="absolute inset-0 bg-[#03112b]"></div>

            <div class="newsletter-ambient absolute inset-0">
              <div class="ambient-blob ambient-blob-blue"></div>
              <div class="ambient-blob ambient-blob-green"></div>
              <div class="ambient-blob ambient-blob-blue-soft"></div>
              <div class="ambient-vignette"></div>
              <div class="ambient-noise"></div>
            </div>

            <!-- TOP BUTTONS -->
            <div class="relative z-[2] flex flex-col gap-3 px-5 pt-5 sm:px-6 sm:pt-6 md:flex-row md:items-center md:justify-between md:px-8 md:pt-8 lg:px-10 lg:pt-10">
              <a
                href="/"
                class="inline-flex min-h-[44px] w-fit items-center justify-center rounded-full border border-white/15 bg-white/10 px-5 py-2.5 text-sm font-medium text-white backdrop-blur transition hover:border-white/25 hover:bg-white/15"
              >
                Home
              </a>

              <button
                id="theme-toggle"
                type="button"
                aria-label="Toggle theme"
                class="inline-flex min-h-[44px] w-fit items-center justify-center rounded-full border border-white/15 bg-white/10 px-5 py-2.5 text-sm font-medium text-white backdrop-blur transition hover:border-white/25 hover:bg-white/15"
              >
                Change theme
              </button>
            </div>

            <!-- CENTER -->
            <div class="relative z-[2] flex flex-1 items-center justify-center px-5 py-12 sm:px-6 sm:py-14 md:px-8 md:py-16 lg:px-10 lg:py-20">
              <div class="relative text-center">
                

                <h2 class="mt-6 text-6xl font-extrabold tracking-tight text-[#ffffff] sm:text-7xl md:text-8xl">
                  BFC
                </h2>

                
              </div>
            </div>

            <!-- BOTTOM TEXT -->
            <div class="relative z-[2] px-5 pb-6 sm:px-6 sm:pb-8 md:px-8 lg:px-10 lg:pb-10">
              <p class="max-w-sm text-sm text-white/60">
                Founder updates, portfolio news, and thoughtful insights from BFC.
              </p>
            </div>
          </div>

          <!-- RIGHT -->
          <div class="flex items-center justify-center px-5 py-10 sm:px-6 sm:py-12 md:px-10 md:py-14 lg:px-14 lg:py-16 xl:px-20">
            <div class="w-full max-w-2xl">
              <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100 sm:text-5xl xl:text-6xl">
                Subscribe to Our Newsletter
              </h1>

              <p class="mt-5 text-base text-slate-600 dark:text-slate-400 md:text-lg">
                Your information will never be shared with third parties, and you can unsubscribe at any time.
              </p>

              <form id="newsletter-page-form" class="mt-8 space-y-4">
                <div class="grid gap-4 md:grid-cols-2">
                  <input
                    type="text"
                    name="FNAME"
                    placeholder="First Name"
                    required
                    class="w-full rounded-full border border-slate-200 px-5 py-4 dark:border-slate-700 dark:bg-slate-900"
                  />

                  <input
                    type="text"
                    name="LNAME"
                    placeholder="Last Name"
                    required
                    class="w-full rounded-full border border-slate-200 px-5 py-4 dark:border-slate-700 dark:bg-slate-900"
                  />
                </div>

                <input
                  type="email"
                  name="EMAIL"
                  placeholder="name@email.com"
                  required
                  class="w-full rounded-full border border-slate-200 px-5 py-4 dark:border-slate-700 dark:bg-slate-900"
                />

                <button
                  type="submit"
                  class="w-full rounded-full bg-slate-900 px-8 py-4 text-white dark:bg-slate-100 dark:text-slate-900"
                >
                  Subscribe Now
                </button>

                <input type="hidden" name="tags" value="4889172" />
              </form>

              <div id="newsletter-page-success" class="mt-6 hidden text-green-600">
                Check your inbox to confirm your subscription.
              </div>

              <div id="newsletter-page-error" class="mt-6 hidden text-red-600">
                Something went wrong. Try again.
              </div>
            </div>
          </div>

        </div>
      </section>
    </main>

    <!-- THEME -->
    <script is:inline>
      const themeToggle = document.getElementById('theme-toggle');
      themeToggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>

    <!-- FORM -->
    <script is:inline>
      const form = document.getElementById('newsletter-page-form');
      const success = document.getElementById('newsletter-page-success');
      const error = document.getElementById('newsletter-page-error');

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();

        try {
          await fetch('https://bfc.us8.list-manage.com/subscribe/post?u=b24a4a180be6b26d2e7ed0cdb&id=aab85c465a', {
            method: 'POST',
            body: new FormData(form),
            mode: 'no-cors',
          });

          form.reset();
          success.classList.remove('hidden');
        } catch {
          error.classList.remove('hidden');
        }
      });
    </script>

    <!-- ANIMATION -->
    <style is:global>
      .ambient-blob {
        position: absolute;
        border-radius: 9999px;
        filter: blur(80px);
      }

      .ambient-blob-blue {
        top: -10%;
        right: 10%;
        width: 300px;
        height: 300px;
        background: rgba(96,140,255,0.4);
        animation: move1 14s ease-in-out infinite;
      }

      .ambient-blob-green {
        top: -5%;
        right: -10%;
        width: 360px;
        height: 360px;
        background: rgba(183,242,127,0.4);
        animation: move2 18s ease-in-out infinite;
      }

      .ambient-blob-blue-soft {
        bottom: -10%;
        left: -10%;
        width: 280px;
        height: 280px;
        background: rgba(96,140,255,0.2);
        animation: move3 16s ease-in-out infinite;
      }

      @keyframes move1 {
        0%,100% { transform: translate(0,0) scale(1); }
        50% { transform: translate(20px,20px) scale(1.05); }
      }

      @keyframes move2 {
        0%,100% { transform: translate(0,0); }
        50% { transform: translate(-20px,20px); }
      }

      @keyframes move3 {
        0%,100% { transform: translate(0,0); }
        50% { transform: translate(20px,-10px); }
      }

      .ambient-vignette {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle, transparent 40%, rgba(0,0,0,0.6));
      }

      .ambient-noise {
        position: absolute;
        inset: 0;
        opacity: 0.05;
        background-image: radial-gradient(#fff 1px, transparent 1px);
        background-size: 6px 6px;
      }
    </style>
  </body>
</html>