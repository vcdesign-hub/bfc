---
import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Newsletter | BFC</title>
    <meta
      name="description"
      content="Subscribe to the BFC newsletter for updates on portfolio companies, founder stories, investments, and insights."
    />

    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

      if (storedTheme === 'dark' || (!storedTheme && systemPrefersDark)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen bg-white font-sans text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <main class="min-h-screen bg-white dark:bg-slate-950">
      <section class="min-h-screen">
        <div class="grid min-h-screen overflow-hidden bg-white dark:bg-slate-950 lg:grid-cols-[minmax(0,0.42fr)_minmax(0,0.58fr)]">
          <!-- LEFT -->
          <div class="relative min-h-[42vh] overflow-hidden border-b border-slate-200 bg-slate-950 lg:min-h-screen lg:border-b-0 lg:border-r lg:border-slate-800">
            <div class="absolute inset-0 bg-[#03112b]"></div>

            <div class="newsletter-ambient absolute inset-0">
              <div class="ambient-blob ambient-blob-blue"></div>
              <div class="ambient-blob ambient-blob-green"></div>
              <div class="ambient-blob ambient-blob-blue-soft"></div>
              <div class="ambient-vignette"></div>
              <div class="ambient-noise"></div>
            </div>

            <!-- TOP BUTTONS -->
            <div class="absolute left-0 right-0 top-0 z-[3] px-5 pt-5 sm:px-6 sm:pt-6 md:px-8 md:pt-8 lg:px-10 lg:pt-10">
              <div class="flex items-center gap-3">
                <a
                  href="/"
                  aria-label="Go to home"
                  class="flex h-12 w-12 items-center justify-center rounded-full border border-white/25 bg-white/5 text-white backdrop-blur transition hover:bg-white/10"
                >
                  <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                  >
                    <path
                      d="M4.5 10.5 12 4l7.5 6.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                    />
                    <path
                      d="M7.5 9.75V19.5h9V9.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                    />
                  </svg>
                </a>

                <button
                  id="theme-toggle"
                  type="button"
                  aria-label="Theme toggle"
                  class="flex h-12 w-12 items-center justify-center rounded-full border border-white/25 bg-white/5 text-white backdrop-blur transition hover:bg-white/10"
                >
                  <svg
                    id="theme-toggle-moon"
                    class="h-5 w-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      d="M20.354 15.354A9 9 0 0 1 8.646 3.646 9.003 9.003 0 0 0 12 21a9.003 9.003 0 0 0 8.354-5.646Z"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                    />
                  </svg>

                  <svg
                    id="theme-toggle-sun"
                    class="hidden h-5 w-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      d="M12 3v2.25M12 18.75V21M21 12h-2.25M5.25 12H3M18.364 5.636l-1.591 1.591M7.227 16.773l-1.591 1.591M18.364 18.364l-1.591-1.591M7.227 7.227 5.636 5.636M15.75 12A3.75 3.75 0 1 1 8.25 12a3.75 3.75 0 0 1 7.5 0Z"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                    />
                  </svg>
                </button>
              </div>
            </div>

            <!-- CENTER -->
            <div class="relative z-[2] flex min-h-[42vh] items-center justify-center px-5 py-16 sm:px-6 sm:py-20 md:px-8 md:py-24 lg:min-h-screen lg:px-10 lg:py-20">
              <div class="relative text-center">
                <h2 class="text-6xl font-extrabold tracking-tight text-white sm:text-7xl md:text-8xl">
                  BFC
                </h2>
              </div>
            </div>
          </div>

          <!-- RIGHT -->
          <div class="flex items-center justify-center px-5 py-10 sm:px-6 sm:py-12 md:px-10 md:py-14 lg:px-14 lg:py-16 xl:px-20">
            <div class="w-full max-w-2xl">
              <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100 sm:text-5xl xl:text-6xl">
                Subscribe to Our Newsletter
              </h1>

              <p class="mt-5 text-base text-slate-600 dark:text-slate-400 md:text-lg">
                Your information will never be shared with third parties, and you can unsubscribe at any time.
              </p>

              <form id="newsletter-page-form" class="mt-8 space-y-4">
                <div class="grid gap-4 md:grid-cols-2">
                  <input
                    type="text"
                    name="FNAME"
                    placeholder="First Name"
                    required
                    class="w-full rounded-full border border-slate-200 px-5 py-4 dark:border-slate-700 dark:bg-slate-900"
                  />

                  <input
                    type="text"
                    name="LNAME"
                    placeholder="Last Name"
                    required
                    class="w-full rounded-full border border-slate-200 px-5 py-4 dark:border-slate-700 dark:bg-slate-900"
                  />
                </div>

                <input
                  type="email"
                  name="EMAIL"
                  placeholder="name@email.com"
                  required
                  class="w-full rounded-full border border-slate-200 px-5 py-4 dark:border-slate-700 dark:bg-slate-900"
                />

                <button
                  type="submit"
                  class="w-full rounded-full bg-slate-900 px-8 py-4 text-white dark:bg-slate-100 dark:text-slate-900"
                >
                  Subscribe Now
                </button>

                <input type="hidden" name="tags" value="4889172" />
              </form>

              <div id="newsletter-page-success" class="mt-6 hidden text-green-600">
                Check your inbox to confirm your subscription.
              </div>

              <div id="newsletter-page-error" class="mt-6 hidden text-red-600">
                Something went wrong. Try again.
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- THEME -->
    <script is:inline>
      const themeToggle = document.getElementById('theme-toggle');
      const themeToggleSun = document.getElementById('theme-toggle-sun');
      const themeToggleMoon = document.getElementById('theme-toggle-moon');

      function syncThemeIcon() {
        const isDark = document.documentElement.classList.contains('dark');

        if (isDark) {
          themeToggleSun?.classList.remove('hidden');
          themeToggleMoon?.classList.add('hidden');
        } else {
          themeToggleSun?.classList.add('hidden');
          themeToggleMoon?.classList.remove('hidden');
        }
      }

      syncThemeIcon();

      themeToggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        syncThemeIcon();
      });
    </script>

    <!-- FORM -->
    <script is:inline>
      const form = document.getElementById('newsletter-page-form');
      const success = document.getElementById('newsletter-page-success');
      const error = document.getElementById('newsletter-page-error');

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();

        try {
          await fetch('https://bfc.us8.list-manage.com/subscribe/post?u=b24a4a180be6b26d2e7ed0cdb&id=aab85c465a', {
            method: 'POST',
            body: new FormData(form),
            mode: 'no-cors',
          });

          form.reset();
          success.classList.remove('hidden');
          error.classList.add('hidden');
        } catch {
          error.classList.remove('hidden');
          success.classList.add('hidden');
        }
      });
    </script>

    <!-- ANIMATION -->
    <style is:global>
  /* BASE = MOBILE FIRST (subtle, lighter) */
  .ambient-blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(60px);
    opacity: 0.5;
  }

  .ambient-blob-blue {
    top: -6%;
    right: 6%;
    width: 180px;
    height: 180px;
    background: rgba(96, 140, 255, 0.3);
    animation: move1 14s ease-in-out infinite;
  }

  .ambient-blob-green {
    top: -6%;
    right: -6%;
    width: 220px;
    height: 220px;
    background: rgba(183, 242, 127, 0.3);
    animation: move2 18s ease-in-out infinite;
  }

  .ambient-blob-blue-soft {
    bottom: -6%;
    left: -6%;
    width: 160px;
    height: 160px;
    background: rgba(96, 140, 255, 0.15);
    animation: move3 16s ease-in-out infinite;
  }

  /* DESKTOP = stronger visual */
  @media (min-width: 1024px) {
    .ambient-blob {
      filter: blur(80px);
      opacity: 1;
    }

    .ambient-blob-blue {
      top: -10%;
      right: 10%;
      width: 300px;
      height: 300px;
    }

    .ambient-blob-green {
      top: -5%;
      right: -10%;
      width: 360px;
      height: 360px;
    }

    .ambient-blob-blue-soft {
      bottom: -10%;
      left: -10%;
      width: 280px;
      height: 280px;
    }
  }

  /* OPTIONAL: remove one blob on very small screens */
  @media (max-width: 480px) {
    .ambient-blob-green {
      display: none;
    }
  }

  /* ANIMATIONS (unchanged) */
  @keyframes move1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(20px, 20px) scale(1.05); }
  }

  @keyframes move2 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-20px, 20px); }
  }

  @keyframes move3 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(20px, -10px); }
  }

  /* VIGNETTE (lighter on mobile) */
  .ambient-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, transparent 50%, rgba(0, 0, 0, 0.4));
  }

  @media (min-width: 1024px) {
    .ambient-vignette {
      background: radial-gradient(circle, transparent 40%, rgba(0, 0, 0, 0.6));
    }
  }

  /* NOISE (keep subtle) */
  .ambient-noise {
    position: absolute;
    inset: 0;
    opacity: 0.04;
    background-image: radial-gradient(#fff 1px, transparent 1px);
    background-size: 6px 6px;
  }
</style>
  </body>
</html>