  {
    image: 'https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=1200&q=80',
    caption: 'Panel discussion with investors during Frankfurter Finanzplaner Forum 2025',
    height: 'h-52',
  },
  {
    image: 'https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1200&q=80',
    caption: 'With founders and operators after a community meetup',
    height: 'h-44',
  },
  {
    image: 'https://images.unsplash.com/photo-1505373877841-8d25f7d46678?auto=format&fit=crop&w=1200&q=80',
    caption: 'Networking moment during an evening event',
    height: 'h-36',
  },
  {
    image: 'https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=1200&q=80',
    caption: 'Stage session with speakers and guests',
    height: 'h-48',
  },
  {
    image: 'https://images.unsplash.com/photo-1540317580384-e5d43616b9aa?auto=format&fit=crop&w=1200&q=80',
    caption: 'Quiet conversation before a founder session',
    height: 'h-56',
  },
  {
    image: 'https://images.unsplash.com/photo-1515169067868-5387ec356754?auto=format&fit=crop&w=1200&q=80',
    caption: 'Meeting builders and investors in a warm event setting',
    height: 'h-40',
  },
  {
    image: 'https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=1200&q=80',
    caption: 'Snapshot from a conference gathering',
    height: 'h-44',
  },
  {
    image: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?auto=format&fit=crop&w=1200&q=80',
    caption: 'Listening to a founder pitch on stage',
    height: 'h-52',
  },
  {
    image: 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1200&q=80',
    caption: 'Founder conversation after a product talk',
    height: 'h-40',
  },
  {
    image: 'https://images.unsplash.com/photo-1528605248644-14dd04022da1?auto=format&fit=crop&w=1200&q=80',
    caption: 'Community moment during a casual meetup',
    height: 'h-48',
  },
  {
    image: 'https://images.unsplash.com/photo-1511576661531-b34d7da5d0bb?auto=format&fit=crop&w=1200&q=80',
    caption: 'Live event with guests and speakers',
    height: 'h-56',
  },
  {
    image: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=1200&q=80',
    caption: 'Founder dinner with ecosystem partners',
    height: 'h-44',
  },
  {
    image: 'https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=1200&q=80',
    caption: 'Table discussion with builders and operators',
    height: 'h-40',
  },
  {
    image: 'https://images.unsplash.com/photo-1516321497487-e288fb19713f?auto=format&fit=crop&w=1200&q=80',
    caption: 'VC and startup session during a packed conference day',
    height: 'h-52',
  },
  {
    image: 'https://images.unsplash.com/photo-1515187029135-18ee286d815b?auto=format&fit=crop&w=1200&q=80',
    caption: 'A friendly moment after a panel',
    height: 'h-36',
  },
  {
    image: 'https://images.unsplash.com/photo-1503428593586-e225b39bddfe?auto=format&fit=crop&w=1200&q=80',
