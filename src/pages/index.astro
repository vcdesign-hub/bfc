---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const portfolioRaw = await getCollection("portfolio");

const portfolioItems = portfolioRaw.map((item) => ({
  name: item.data.name,
  desc: item.data.mission,
  image: item.data.image,
  imageBg: item.data.imageBg,
}));

const allNews = await getCollection("news");

const latestNews = allNews
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const newsItems = latestNews.map((item) => ({
  slug: item.slug,
  tag: item.data.tag,
  title: item.data.title,
  desc: item.data.description,
  date: item.data.date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }),
  time: item.data.minRead,
  image: item.data.image,
}));

const focusCards = [
  {
    title: "Scope",
    text: "Non consensus insight driven ideas based on inflection points",
  },
  {
    title: "Founders",
    text: "Obsessed founder teams who want to make a dent in the universe",
  },
  {
    title: "Phase",
    text: "Pre Product Market Fit Pre Seed and Seed",
  },
  {
    title: "Tickets",
    text: "$300k in Europe, North America, Asia",
  },
];

const partnersRaw = await getCollection("partners");

const partners = partnersRaw.map((item) => ({
  name: item.data.name,
  image: item.data.image,
  url: item.data.url,
}));

const snapshots = [
  "https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=900&q=80",
  "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=900&q=80",
  "https://images.unsplash.com/photo-1515169067868-5387ec356754?auto=format&fit=crop&w=900&q=80",
  "https://images.unsplash.com/photo-1505373877841-8d25f7d46678?auto=format&fit=crop&w=900&q=80",
  "https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=900&q=80",
  "https://images.unsplash.com/photo-1540317580384-e5d43616b9aa?auto=format&fit=crop&w=900&q=80",
  "https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=900&q=80",
  "https://images.unsplash.com/photo-1511576661531-b34d7da5d0bb?auto=format&fit=crop&w=900&q=80",
  "https://images.unsplash.com/photo-1504384308090-c894fdcc538d?auto=format&fit=crop&w=900&q=80",
  "https://images.unsplash.com/photo-1528605248644-14dd04022da1?auto=format&fit=crop&w=900&q=80",
];
---

<Layout title="BFC | Venture Capital for the Future of the Internet">
  <main>
    <section class="container-default py-20 md:py-28">
      <div class="max-w-5xl">
        <h1 class="max-w-4xl text-4xl font-extrabold leading-tight tracking-tight text-slate-900 md:text-6xl">
          We invest in founders building the future of the internet
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
          We are honored to back fantastic teams on a mission.
        </p>
      </div>
    </section>

    <section class="container-default pb-24">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {portfolioItems.map((item) => (
          <article class="group relative aspect-square overflow-hidden rounded-3xl">
            <div class={`absolute inset-0 ${item.imageBg}`}></div>

            <img
              src={item.image}
              alt={item.name}
              class="absolute inset-0 h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]"
            />

            <!-- <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent"></div>

            <div class="relative z-10 flex h-full flex-col justify-end p-8 text-white">
              <h3 class="text-2xl font-bold tracking-tight md:text-3xl">{item.name}</h3>
              <p class="mt-3 text-sm leading-6 text-white/80">{item.desc}</p>
            </div> -->
          </article>
        ))}
      </div>
    </section>

    <section class="bg-slate-50 py-24">
      <div class="container-default">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">
          Our investment focus
        </h2>
        <p class="mt-3 text-lg text-slate-600">
          We like to invest in things that no one cares about. Yet.
        </p>

        <div class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
          {focusCards.map((card) => (
            <article class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-soft">
              <div class="flex items-center justify-between bg-slate-900 px-4 py-3 text-white">
                <span class="text-xs font-bold uppercase tracking-[0.2em]">{card.title}</span>
                <span class="text-sm opacity-70">●</span>
              </div>
              <div class="flex min-h-[180px] items-center justify-center p-8 text-center">
                <p class="font-medium leading-7 text-slate-800">{card.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container-default py-24">
      <div class="grid items-center gap-12 md:grid-cols-[280px_minmax(0,1fr)]">
        <div class="mx-auto h-56 w-56 overflow-hidden rounded-full bg-slate-100 md:h-72 md:w-72">
          <img
            src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=1000&q=80"
            alt="Founder portrait"
            class="h-full w-full object-cover"
          />
        </div>

        <div>
          <h2 class="text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">
            What our founders say about us
          </h2>
          <p class="mt-3 text-lg text-slate-600">
            No founders were harmed in the making of this statement.
          </p>

          <blockquote class="relative mt-10 text-xl italic leading-9 text-slate-700 md:text-2xl">
            Blockchain Founders Capital relentlessly supported us during our fundraising,
            even before the paperwork was signed. I completely trust them and plan to be
            lifelong partners.
          </blockquote>

          <div class="mt-8 inline-flex rounded-2xl bg-slate-900 px-5 py-4 text-white">
            <div>
              <p class="font-semibold">Raechel Lambert</p>
              <p class="text-sm text-white/70">CEO and Co Founder of River</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-slate-200 bg-white py-24">
      <div class="container-default">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">
          It takes a village to raise a startup
        </h2>
        <p class="mt-3 max-w-3xl text-lg text-slate-600">
          We share ideas, learn from, and co invest with leading minds in the blockchain and venture capital community.
        </p>
    
        <div class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-slate-200 bg-slate-200 md:grid-cols-4 lg:grid-cols-6">
          {partners.map((partner) => (
            <a
              href={partner.url}
              target="_blank"
              rel="noreferrer"
              class="flex h-24 items-center justify-center bg-white px-6 transition hover:bg-slate-50"
            >
              <img
                src={partner.image}
                alt={partner.name}
                class="max-h-20 w-auto object-contain opacity-70 transition hover:opacity-100"
              />
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="container-default py-24">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">
        Meeting founders, investors and friends
      </h2>
      <p class="mt-3 text-lg text-slate-600">
        Click on any photo to jump to Snapshots.
      </p>

      <div class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-4 lg:grid-cols-5">
        {snapshots.map((image) => (
          <a href="#" class="group block overflow-hidden rounded-2xl">
            <img
              src={image}
              alt="Event snapshot"
              class="h-48 w-full object-cover transition duration-300 group-hover:scale-105"
            />
          </a>
        ))}
      </div>
    </section>

    <section class="container-default border-t border-slate-200 py-24">
      <div class="flex items-end justify-between gap-6">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">
            What we have been up to
          </h2>
          <p class="mt-3 text-lg text-slate-600">
            Do not forget to <a href="/news" class="font-medium text-slate-900 underline">subscribe</a> to our newsletter.
          </p>
        </div>

        <a
          href="/news"
          class="hidden rounded-full bg-slate-900 px-5 py-2 text-sm font-medium text-white transition hover:bg-slate-800 md:inline-flex"
        >
          View all
        </a>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {newsItems.map((item) => (
          <article class="group relative flex h-full flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-soft transition hover:shadow-lg">
            <a
              href={`/news/${item.slug}`}
              aria-label={`Read ${item.title}`}
              class="absolute inset-0 z-10"
            ></a>

            <img
              src={item.image}
              alt={item.title}
              class="h-56 w-full object-cover transition duration-300 group-hover:scale-[1.02]"
            />

            <div class="flex flex-1 flex-col p-8">
              <span class="w-fit rounded-full bg-slate-900 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white">
                {item.tag}
              </span>

              <h3 class="mt-5 text-2xl font-bold tracking-tight text-slate-900">
                {item.title}
              </h3>

              <p class="mt-4 flex-1 text-sm leading-7 text-slate-600">
                {item.desc}
              </p>

              <div class="mt-8 flex items-center justify-between border-t border-slate-200 pt-6 text-xs text-slate-400">
                <span>{item.date}</span>
                <span>{item.time}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>