---
import Layout from "../layouts/Layout.astro";
import ColorBends from "../components/ColorBends";
import { getCollection } from "astro:content";
import TestimonialCard from "../components/TestimonialCard.astro";
import NewsCard from "../components/NewsCard.astro";

const featuredRaw = await getCollection("featured");

const featuredItems = featuredRaw
  .sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0))
  .map((item) => ({
    company: item.data.company,
    people: item.data.people,
    image: item.data.image,
    logo: item.data.logo,
    date: item.data.date.toLocaleDateString("en-US", {
      month: "short",
      year: "numeric",
    }),
    description: item.data.description ?? "",
  }));

const allNews = await getCollection("news");

const latestNews = [...allNews]
  .sort((a, b) => b.data.order - a.data.order)
  .slice(0, 3);

const newsItems = latestNews.map((item) => ({
  slug: item.slug,
  tag: item.data.tag,
  title: item.data.title,
  desc: item.data.description,
  date: item.data.date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }),
  time: item.data.minRead,
  image: item.data.image,
}));

const focusCards = [
  {
    title: "Scope",
    text: "Non consensus insight driven ideas based on inflection points",
    number: "01",
    image: "https://cdn.pixabay.com/photo/2012/03/03/23/15/abstract-21613_1280.jpg",
  },
  {
    title: "Founders",
    text: "Obsessed founder teams who want to make a dent in the universe",
    number: "02",
    image: "https://cdn.pixabay.com/photo/2015/01/09/11/08/startup-594090_1280.jpg",
  },
  {
    title: "Phase",
    text: "Pre Product Market Fit Pre Seed and Seed",
    number: "03",
    image: "https://cdn.pixabay.com/photo/2015/05/28/14/53/ux-788002_1280.jpg",
  },
  {
    title: "Tickets",
    text: "$300k in Europe, North America, Asia",
    number: "04",
    image: "https://images.pexels.com/photos/5846577/pexels-photo-5846577.jpeg?cs=srgb&dl=pexels-knowbuddy-3920376-5846577.jpg&fm=jpg",
  },
];

const partnersRaw = await getCollection("partners");

const partners = partnersRaw.map((item) => ({
  name: item.data.name,
  image: item.data.image,
  url: item.data.url,
}));

const snapshotsRaw = await getCollection("snapshots");

const snapshots = snapshotsRaw
  .sort((a, b) => b.data.order.valueOf() - a.data.order.valueOf())
  .slice(0, 10)
  .map((item) => ({
    image: item.data.image,
    caption: item.data.caption,
  }));

const testimonialsRaw = await getCollection("testimonials");

const testimonials = testimonialsRaw
  .sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0))
  .map((item) => ({
    category: item.data.category.trim().toLowerCase(),
    company: item.data.company,
    quote: item.data.quote,
    name: item.data.name,
    role: item.data.role,
    logo: item.data.logo,
    image: item.data.image,
    order: item.data.order,
  }));

const creatorsTestimonials = testimonials
  .filter(
    (item) =>
      item.category === "creators" || item.category === "creator"
  )
  .sort((a, b) => (a.order ?? 0) - (b.order ?? 0));

const creatorsTestimonial =
  creatorsTestimonials[0] ||
  testimonials.find((item) => item.category === "all") ||
  testimonials[0];
---

