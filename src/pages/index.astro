              href="/snapshots"
              class:list={[
                "group block overflow-hidden rounded-3xl bg-slate-100 shadow-soft transition duration-300 hover:shadow-xl dark:border-slate-800 dark:bg-slate-900",
                index === 0 ? "col-span-2 row-span-2" : "",
                index === 1 ? "col-span-2 row-span-1" : "",
                index === 2 ? "col-span-1 row-span-1" : "",
                index === 3 ? "col-span-1 row-span-1" : "",
                index === 4 ? "col-span-1 row-span-1" : "",
                index === 5 ? "col-span-1 row-span-1" : "",
                index === 6 ? "col-span-2 row-span-1" : "",
              ]}
            >
              <img
                src={item.image}
                alt={item.caption}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-slate-100 py-16 dark:bg-slate-900/20 sm:py-20 md:py-24">
      <div class="container-default">
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <div>
            <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 md:text-4xl">
              What we have been up to
            </h2>
            <p class="mt-3 text-base text-slate-600 dark:text-slate-300 sm:text-lg">
              Do not forget to <a href="/newsletter" class="font-medium text-slate-900 underline dark:text-slate-100">subscribe</a> to our newsletter.
            </p>
          </div>

          <a
            href="/news"
            class="inline-flex w-fit rounded-full bg-slate-900 px-5 py-2 text-sm font-medium text-white transition hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-200 md:inline-flex"
          >
            View all
          </a>
        </div>

        <div class="mt-10 grid gap-6 sm:mt-12 sm:gap-8 md:grid-cols-2 xl:grid-cols-3">
          {newsItems.map((item) => (
            <NewsCard
              slug={item.slug}
              tag={item.tag}
              title={item.title}
              desc={item.desc}
              date={item.date}
              time={item.time}
              image={item.image}
            />
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script is:inline>
  const carousel = document.getElementById("featured-carousel");

  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll("article"));
    let isPointerDown = false;
    let startX = 0;
    let scrollStart = 0;
    let autoPlayTimeout;
    let currentIndex = 0;

    const stopDragging = () => {
      isPointerDown = false;
      carousel.classList.remove("cursor-grabbing");
      carousel.classList.add("cursor-grab");
    };

    const stopAutoPlay = () => {
      if (autoPlayTimeout) clearTimeout(autoPlayTimeout);
    };

    const goToSlide = (index, behavior = "smooth") => {
      const slide = slides[index];
      if (!slide) return;

      currentIndex = index;

      const targetLeft =
        slide.offsetLeft - (carousel.clientWidth - slide.clientWidth) / 2;

      carousel.scrollTo({
        left: targetLeft,
        behavior,
      });
    };

    const getClosestSlideIndex = () => {
      const carouselCenter = carousel.scrollLeft + carousel.clientWidth / 2;

      let closestIndex = 0;
      let closestDistance = Infinity;

      slides.forEach((slide, index) => {
        const slideCenter = slide.offsetLeft + slide.clientWidth / 2;
        const distance = Math.abs(carouselCenter - slideCenter);

        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      return closestIndex;
    };

    const queueNextAutoPlay = () => {
      stopAutoPlay();

      autoPlayTimeout = setTimeout(() => {
        currentIndex = getClosestSlideIndex();

        if (currentIndex >= slides.length - 1) {
          goToSlide(0, "smooth");
        } else {
          goToSlide(currentIndex + 1, "smooth");
        }

        queueNextAutoPlay();
      }, 4000);
    };

    carousel.addEventListener("mousedown", (event) => {
      isPointerDown = true;
      startX = event.pageX;
      scrollStart = carousel.scrollLeft;
      carousel.classList.remove("cursor-grab");
      carousel.classList.add("cursor-grabbing");
      stopAutoPlay();
    });

    carousel.addEventListener(
      "touchstart",
      (event) => {
        isPointerDown = true;
        startX = event.touches[0].pageX;
        scrollStart = carousel.scrollLeft;
        stopAutoPlay();
      },
      { passive: true }
    );

    carousel.addEventListener("mouseleave", () => {
      stopDragging();
      currentIndex = getClosestSlideIndex();
      queueNextAutoPlay();
    });

    carousel.addEventListener("mouseup", () => {
      stopDragging();
      currentIndex = getClosestSlideIndex();
      queueNextAutoPlay();
    });

    carousel.addEventListener("touchend", () => {
      stopDragging();
      currentIndex = getClosestSlideIndex();
      queueNextAutoPlay();
    });

    carousel.addEventListener("mousemove", (event) => {
      if (!isPointerDown) return;
      event.preventDefault();
      const distance = event.pageX - startX;
      carousel.scrollLeft = scrollStart - distance;
    });

    carousel.addEventListener(
      "touchmove",
      (event) => {
        if (!isPointerDown) return;
        const distance = event.touches[0].pageX - startX;
        carousel.scrollLeft = scrollStart - distance;
      },
      { passive: true }
    );

    carousel.addEventListener("mouseenter", stopAutoPlay);

    carousel.addEventListener("scroll", () => {
      stopAutoPlay();
      clearTimeout(carousel.__snapTimeout);
      carousel.__snapTimeout = setTimeout(() => {
        currentIndex = getClosestSlideIndex();
        queueNextAutoPlay();
      }, 120);
    });

    window.addEventListener("resize", () => {
      currentIndex = getClosestSlideIndex();
      goToSlide(currentIndex, "smooth");
    });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        stopAutoPlay();
      } else {
        currentIndex = getClosestSlideIndex();
        queueNextAutoPlay();
      }
    });

    currentIndex = getClosestSlideIndex();
    queueNextAutoPlay();
  }
</script>