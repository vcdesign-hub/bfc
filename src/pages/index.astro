---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import TestimonialCard from "../components/TestimonialCard.astro";
import NewsCard from "../components/NewsCard.astro";

const featuredRaw = await getCollection("featured");

const featuredItems = featuredRaw
  .sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0))
  .map((item) => ({
    company: item.data.company,
    people: item.data.people,
    image: item.data.image,
    logo: item.data.logo,
    date: item.data.date.toLocaleDateString("en-US", {
      month: "short",
      year: "numeric",
    }),
    description: item.data.description ?? "",
  }));

const allNews = await getCollection("news");

const latestNews = [...allNews]
  .sort((a, b) => b.data.order - a.data.order)
  .slice(0, 3);

const newsItems = latestNews.map((item) => ({
  slug: item.slug,
  tag: item.data.tag,
  title: item.data.title,
  desc: item.data.description,
  date: item.data.date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }),
  time: item.data.minRead,
  image: item.data.image,
}));

const focusCards = [
  {
    title: "Scope",
    text: "Non consensus insight driven ideas based on inflection points",
    number: "01",
    image: "https://cdn.pixabay.com/photo/2012/03/03/23/15/abstract-21613_1280.jpg",
  },
  {
    title: "Founders",
    text: "Obsessed founder teams who want to make a dent in the universe",
    number: "02",
    image: "https://cdn.pixabay.com/photo/2015/01/09/11/08/startup-594090_1280.jpg",
  },
  {
    title: "Phase",
    text: "Pre Product Market Fit Pre Seed and Seed",
    number: "03",
    image: "https://cdn.pixabay.com/photo/2015/05/28/14/53/ux-788002_1280.jpg",
  },
  {
    title: "Tickets",
    text: "$300k in Europe, North America, Asia",
    number: "04",
    image: "https://images.pexels.com/photos/5846577/pexels-photo-5846577.jpeg?cs=srgb&dl=pexels-knowbuddy-3920376-5846577.jpg&fm=jpg",
  },
];

const partnersRaw = await getCollection("partners");

const partners = partnersRaw.map((item) => ({
  name: item.data.name,
  image: item.data.image,
  url: item.data.url,
}));

const snapshotsRaw = await getCollection("snapshots");

const snapshots = snapshotsRaw
  .sort((a, b) => b.data.order.valueOf() - a.data.order.valueOf())
  .slice(0, 10)
  .map((item) => ({
    image: item.data.image,
    caption: item.data.caption,
  }));

const testimonialsRaw = await getCollection("testimonials");

const testimonials = testimonialsRaw
  .sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0))
  .map((item) => ({
    category: item.data.category.trim().toLowerCase(),
    company: item.data.company,
    quote: item.data.quote,
    name: item.data.name,
    role: item.data.role,
    logo: item.data.logo,
    image: item.data.image,
    order: item.data.order,
  }));

const creatorsTestimonials = testimonials
  .filter(
    (item) =>
      item.category === "creators" || item.category === "creator"
  )
  .sort((a, b) => (a.order ?? 0) - (b.order ?? 0));

const creatorsTestimonial =
  creatorsTestimonials[0] ||
  testimonials.find((item) => item.category === "all") ||
  testimonials[0];
---

<Layout title="BFC | Venture Capital for the Future of the Internet">
  <main>
    <section class="container-default py-20 md:py-28">
      <div class="max-w-5xl">
        <h1 class="max-w-4xl text-4xl font-extrabold leading-tight tracking-tight text-slate-900 dark:text-slate-100 md:text-6xl">
          We invest in founders building the future of the internet
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">
          We are honored to back fantastic teams on a mission.
        </p>
      </div>
    </section>

    <section class="pb-24">
      <div class="mt-12">
        <div
          id="featured-carousel"
          class="no-scrollbar flex snap-x snap-mandatory gap-6 overflow-x-auto px-4 pb-4 md:px-8 lg:px-[max(2rem,calc((100vw-1280px)/2+2rem))] cursor-grab select-none"
          style="scroll-padding-left: max(1rem, calc((100vw - 1280px)/2));"
        >
          {featuredItems.map((item) => (
            <article class="w-[90vw] max-w-[1200px] shrink-0 snap-center overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-soft dark:border-slate-800 dark:bg-slate-900">
              <div class="grid min-h-[420px] md:grid-cols-[1.25fr_0.9fr]">
                <div class="flex h-full flex-col justify-between bg-slate-50 p-8 dark:bg-slate-900/70 md:p-10">
                  <div>
                    <div class="mb-8 flex items-center gap-3">
                      <div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-xl bg-slate-100 ring-1 ring-slate-200 dark:bg-slate-800 dark:ring-slate-700">
                        <img
                          src={item.logo}
                          alt={`${item.company} logo`}
                          class="h-full w-full object-contain"
                          loading="lazy"
                        />
                      </div>
    
                      <div>
                        <p class="text-base font-semibold text-slate-900 dark:text-slate-100">
                          {item.company}
                        </p>
                        <p class="text-sm text-slate-500 dark:text-slate-400">
                          Portfolio company
                        </p>
                      </div>
                    </div>
    
                    
    
                    {item.description && (
                      <p class="mt-6 max-w-2xl text-base leading-8 text-slate-600 dark:text-slate-300">
                        {item.description}
                      </p>
                    )}
    
                    <!-- <a
                      href="/portfolio"
                      class="mt-8 inline-flex text-sm font-medium text-slate-900 underline underline-offset-4 transition hover:text-blue-600 dark:text-slate-100 dark:hover:text-blue-400"
                    >
                      View portfolio
                    </a> -->
                  </div>
    
                  <div class="mt-10 grid gap-4 sm:grid-cols-2">
                    <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-800/80">
                      <p class="text-xs uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500">
                        People from left
                      </p>
                      <p class="mt-3 text-base font-medium text-slate-900 dark:text-slate-100">
                        {item.people.join(", ")}
                      </p>
                    </div>
                  
                    <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-800/80">
                      <p class="text-xs uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500">
                        Investment date
                      </p>
                      <p class="mt-3 text-base font-medium text-slate-900 dark:text-slate-100">
                        {item.date}
                      </p>
                    </div>
                  </div>
                </div>
    
                <div class="relative min-h-[320px] bg-slate-100 dark:bg-slate-800">
                  <img
                    src={item.image}
                    alt={item.company}
                    class="h-full w-full object-cover"
                    loading="lazy"
                  />
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-slate-50 py-24 dark:bg-slate-900/40">
      <div class="container-default">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-200 md:text-4xl">
          Our investment focus
        </h2>
        <p class="mt-3 max-w-3xl text-lg text-slate-600 dark:text-slate-300">
          We like to invest in things that no one cares about. Yet.
        </p>

        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {focusCards.map((card) => (
            <article class="group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-soft transition duration-200 dark:border-slate-800 dark:bg-slate-900">
              <div class="grid h-full gap-0 md:grid-cols-[220px_minmax(0,1fr)]">
                <div class="relative min-h-[220px] overflow-hidden border-b border-slate-200 bg-slate-100 dark:border-slate-800 dark:bg-slate-800 md:min-h-full md:border-b-0 md:border-r">
                  <img
                    src={card.image}
                    alt={card.title}
                    class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/20 to-transparent dark:from-slate-950/30"></div>
                </div>

                <div class="flex h-full flex-col p-8">
                  <div class="flex items-start justify-between gap-4">
                    <p class="max-w-[22rem] text-2xl font-medium leading-9 tracking-tight text-slate-900 dark:text-slate-100">
                      {card.text}
                    </p>
                  </div>

                  <div class="mt-8 flex items-center justify-between border-t border-slate-200 pt-6 text-xs uppercase tracking-[0.18em] text-slate-400 dark:border-slate-800 dark:text-slate-500">
                    <span>{card.title}</span>
                    <span>{card.number}</span>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container-default py-24">
      <div class="mb-10 max-w-2xl">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 md:text-4xl">
          What our founders say about us
        </h2>
        <p class="mt-3 text-lg text-slate-600 dark:text-slate-300">
          We back founders with conviction and stay close when it matters most.
        </p>
      </div>
    
      {creatorsTestimonial && (
        <TestimonialCard
          quote={creatorsTestimonial.quote}
          name={creatorsTestimonial.name}
          role={creatorsTestimonial.role}
          company={creatorsTestimonial.company}
          logo={creatorsTestimonial.logo}
          image={creatorsTestimonial.image}
        />
      )}
    </section>

    <section class="bg-slate-50 py-24 dark:bg-slate-900/40">
      <div class="container-default">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 md:text-4xl">
          It takes a village to raise a startup
        </h2>
        <p class="mt-3 max-w-3xl text-lg text-slate-600 dark:text-slate-300">
          We share ideas, learn from, and co invest with leading minds in the blockchain and venture capital community.
        </p>

        <div class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-slate-200 bg-slate-200 dark:border-slate-700 dark:bg-slate-200 md:grid-cols-4 lg:grid-cols-6">
          {partners.map((partner) => (
            <a
              href={partner.url}
              target="_blank"
              rel="noreferrer"
              class="flex h-24 items-center justify-center bg-white px-6 transition hover:bg-slate-50"
            >
              <img
                src={partner.image}
                alt={partner.name}
                class="max-h-20 w-auto object-contain opacity-70 transition hover:opacity-100"
              />
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="container-default py-24">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 md:text-4xl">
        Meeting founders, investors and friends
      </h2>
      <p class="mt-3 text-lg text-slate-600 dark:text-slate-300">
        Click on any photo to view all snapshots.
      </p>

      <div class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-4 lg:grid-cols-5">
        {snapshots.map((item) => (
          <a
            href="/snapshots"
            class="group block overflow-hidden rounded-2xl"
          >
            <img
              src={item.image}
              alt={item.caption}
              class="h-48 w-full object-cover transition duration-300 group-hover:scale-105"
              loading="lazy"
            />
          </a>
        ))}
      </div>
    </section>

    <section class="container-default border-slate-200 py-24 dark:border-slate-800">
      <div class="flex items-end justify-between gap-6">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 md:text-4xl">
            What we have been up to
          </h2>
          <p class="mt-3 text-lg text-slate-600 dark:text-slate-300">
            Do not forget to <a href="/news" class="font-medium text-slate-900 underline dark:text-slate-100">subscribe</a> to our newsletter.
          </p>
        </div>

        <a
          href="/news"
          class="hidden rounded-full bg-slate-900 px-5 py-2 text-sm font-medium text-white transition hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-200 md:inline-flex"
        >
          View all
        </a>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {newsItems.map((item) => (
          <NewsCard
            slug={item.slug}
            tag={item.tag}
            title={item.title}
            desc={item.desc}
            date={item.date}
            time={item.time}
            image={item.image}
          />
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script is:inline>
  const carousel = document.getElementById("featured-carousel");

  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll("article"));
    let isPointerDown = false;
    let startX = 0;
    let scrollStart = 0;
    let autoPlayTimeout;
    let currentIndex = 0;

    const stopDragging = () => {
      isPointerDown = false;
      carousel.classList.remove("cursor-grabbing");
      carousel.classList.add("cursor-grab");
    };

    const stopAutoPlay = () => {
      if (autoPlayTimeout) clearTimeout(autoPlayTimeout);
    };

    const goToSlide = (index, behavior = "smooth") => {
      const slide = slides[index];
      if (!slide) return;

      currentIndex = index;

      const targetLeft =
        slide.offsetLeft - (carousel.clientWidth - slide.clientWidth) / 2;

      carousel.scrollTo({
        left: targetLeft,
        behavior,
      });
    };

    const getClosestSlideIndex = () => {
      const carouselCenter = carousel.scrollLeft + carousel.clientWidth / 2;

      let closestIndex = 0;
      let closestDistance = Infinity;

      slides.forEach((slide, index) => {
        const slideCenter = slide.offsetLeft + slide.clientWidth / 2;
        const distance = Math.abs(carouselCenter - slideCenter);

        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      return closestIndex;
    };

    const queueNextAutoPlay = () => {
      stopAutoPlay();

      autoPlayTimeout = setTimeout(() => {
        currentIndex = getClosestSlideIndex();

        if (currentIndex >= slides.length - 1) {
          goToSlide(0, "smooth");
        } else {
          goToSlide(currentIndex + 1, "smooth");
        }

        queueNextAutoPlay();
      }, 4000);
    };

    carousel.addEventListener("mousedown", (event) => {
      isPointerDown = true;
      startX = event.pageX;
      scrollStart = carousel.scrollLeft;
      carousel.classList.remove("cursor-grab");
      carousel.classList.add("cursor-grabbing");
      stopAutoPlay();
    });

    carousel.addEventListener("mouseleave", () => {
      stopDragging();
      currentIndex = getClosestSlideIndex();
      queueNextAutoPlay();
    });

    carousel.addEventListener("mouseup", () => {
      stopDragging();
      currentIndex = getClosestSlideIndex();
      queueNextAutoPlay();
    });

    carousel.addEventListener("mousemove", (event) => {
      if (!isPointerDown) return;
      event.preventDefault();
      const distance = event.pageX - startX;
      carousel.scrollLeft = scrollStart - distance;
    });

    carousel.addEventListener("mouseenter", stopAutoPlay);
    carousel.addEventListener("mouseleave", () => {
      currentIndex = getClosestSlideIndex();
      queueNextAutoPlay();
    });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        stopAutoPlay();
      } else {
        currentIndex = getClosestSlideIndex();
        queueNextAutoPlay();
      }
    });

    currentIndex = getClosestSlideIndex();
    queueNextAutoPlay();
  }
</script>