---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const peopleRaw = await getCollection("team");

const people = peopleRaw
  .sort((a, b) => a.data.order - b.data.order)
  .map((item) => ({
    id: item.slug,
    name: item.data.name,
    role: item.data.role,
    group: item.data.group,
    image: item.data.image,
    alt: item.data.alt,
    bio: item.data.bio,
    bioHighlight: item.data.bioHighlight ?? "",
    location: item.data.location,
    linkedinUrl: item.data.linkedinUrl,
    websiteUrl: item.data.websiteUrl,
    languages: item.data.languages,
    logos: item.data.logos,
  }));

const groups = [...new Set(people.map((person) => person.group))];
const filters = groups;
const defaultPerson = people[0];
---

<Layout title="Team | BFC">
  <main class="bg-white">
    <section class="container-default py-20 md:py-28">
      <div class="max-w-4xl">
        <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 md:text-6xl">
          Meet our <span class="text-blue-700">team</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
          It’s all about trust. Especially in a trustless architecture
        </p>
      </div>
    </section>

    <section class="sticky top-[73px] z-40 border-y border-slate-200 bg-white/90 py-4 backdrop-blur">
      <div class="container-default flex flex-wrap gap-3">
        {filters.map((filter, index) => (
          <button
            type="button"
            data-filter={filter}
            class={`team-filter rounded-full px-5 py-2 text-sm font-medium transition ${
              index === 0
                ? "bg-slate-900 text-white"
                : "bg-slate-100 text-slate-600 hover:bg-slate-200"
            }`}
          >
            {filter}
          </button>
        ))}
      </div>
    </section>

    <section class="container-default py-24">
      <div class="space-y-6">
        <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
          We’re an equal partnership driven by trust, designed to challenge consensus. No politics, no egos,
          just complementary strengths and a shared focus: backing the best founders building extraordinary
          companies.
        </p>

        <div id="team-grid" class="mt-12 grid gap-6 md:grid-cols-3">
          {people.map((person, index) => (
            <button
              type="button"
              class={`team-card group flex flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white text-left shadow-soft transition duration-300  hover:shadow-lg ${
                index === 0 ? "border-slate-900 bg-slate-50 shadow-xl -translate-y-1" : ""
              }`}
              data-team-card={person.id}
              data-group={person.group}
              data-name={person.name}
              data-role={person.role}
              data-image={person.image}
              data-alt={person.alt}
              data-bio={person.bio}
              data-highlight={person.bioHighlight}
              data-location={person.location}
              data-linkedin={person.linkedinUrl}
              data-website={person.websiteUrl}
              data-languages={JSON.stringify(person.languages)}
              data-logos={JSON.stringify(person.logos)}
            >
            <div class="flex h-72 items-end justify-center bg-slate-100 md:h-[250px]">
                <img
  src={person.image}
  alt={person.alt}
  class="h-full w-auto object-contain"
/>
              </div>

              <div class="flex items-center justify-between bg-slate-900 px-4 py-3 text-white">
                <div class="space-y-0.5">
                  <div class="text-xs font-bold uppercase tracking-[0.2em]">{person.name}</div>
                  <p class="text-sm font-medium leading-6 text-slate-100">{person.role}</p>
                </div>

                <div class={`team-card-icon flex h-8 w-8 items-center justify-center rounded-full border text-sm transition ${
                  index === 0
                    ? "border-white bg-white text-slate-900"
                    : "border-slate-300 bg-slate-800 text-white"
                }`}>
                  <span class="text-base">↕</span>
                </div>
              </div>
            </button>
          ))}
        </div>

        {defaultPerson && (
          <div
            id="team-detail"
            class="mt-12 grid gap-8 overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-soft md:grid-cols-[minmax(0,2fr)_minmax(0,1.2fr)]"
          >
            <div class="flex flex-col gap-6 p-8 text-sm leading-7 text-slate-600">
              <p id="detail-bio" class="text-sm leading-7 text-slate-600">
                {defaultPerson.bioHighlight && defaultPerson.bio.includes(defaultPerson.bioHighlight) ? (
                  <>
                    {defaultPerson.bio.replace(defaultPerson.bioHighlight, "")}
                    <span class="font-semibold text-blue-700">{defaultPerson.bioHighlight}</span>
                  </>
                ) : (
                  defaultPerson.bio
                )}
              </p>

              <div class="flex flex-wrap items-center gap-4 text-slate-400">
                <div class="flex gap-3">
                  <a id="detail-linkedin" href={defaultPerson.linkedinUrl} class="hover:text-slate-900">In</a>
                  <a id="detail-website" href={defaultPerson.websiteUrl} class="hover:text-slate-900">🌐</a>
                </div>

                <span id="detail-location" class="inline-flex items-center gap-2">
                  <span class="h-2 w-2 rounded-full bg-slate-300"></span>
                  {defaultPerson.location}
                </span>
              </div>

              <div id="detail-languages" class="flex flex-wrap gap-2">
                {defaultPerson.languages.map((language) => (
                  <button
                    type="button"
                    class="rounded-full border border-slate-200 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-slate-700"
                  >
                    {language}
                  </button>
                ))}
              </div>
            </div>

            <aside class="flex flex-col justify-between gap-6 border-t border-slate-200 bg-slate-50 p-8 md:border-l md:border-t-0">
              <div id="detail-logos" class="grid grid-cols-2 gap-3">
                {defaultPerson.logos.map((logo) => (
                  <div class="flex h-12 items-center justify-center rounded-lg bg-white text-xs font-semibold text-slate-500 shadow-sm ring-1 ring-slate-200">
                    {logo}
                  </div>
                ))}
              </div>
            </aside>
          </div>
        )}
      </div>
    </section>

    <section class="container-default py-24">
      <div class="grid items-center gap-12 md:grid-cols-[280px_minmax(0,1fr)]">
        <div class="mx-auto h-56 w-56 overflow-hidden rounded-full bg-slate-100 md:h-72 md:w-72">
          <img
            src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=1000&q=80"
            alt="Founder portrait"
            class="h-full w-full object-cover"
          />
        </div>

        <div>
          <h2 class="text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">
            What our founders say about us
          </h2>
          <p class="mt-3 text-lg text-slate-600">
            No founders were harmed in the making of this statement.
          </p>

          <blockquote class="relative mt-10 text-xl italic leading-9 text-slate-700 md:text-2xl">
            Blockchain Founders Capital relentlessly supported us during our fundraising,
            even before the paperwork was signed. I completely trust them and plan to be
            lifelong partners.
          </blockquote>

          <div class="mt-8 inline-flex rounded-2xl bg-slate-900 px-5 py-4 text-white">
            <div>
              <p class="font-semibold">Raechel Lambert</p>
              <p class="text-sm text-white/70">CEO and Co Founder of River</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    const filterButtons = document.querySelectorAll(".team-filter");
    const cards = document.querySelectorAll(".team-card");
    const detail = document.getElementById("team-detail");
    const detailBio = document.getElementById("detail-bio");
    const detailLocation = document.getElementById("detail-location");
    const detailLinkedin = document.getElementById("detail-linkedin");
    const detailWebsite = document.getElementById("detail-website");
    const detailLanguages = document.getElementById("detail-languages");
    const detailLogos = document.getElementById("detail-logos");

    let activeFilter = filterButtons[0]?.dataset.filter || "";

    function resetActiveCards() {
      cards.forEach((card) => {
        card.classList.remove("border-slate-900", "bg-slate-50", "shadow-xl", "-translate-y-1");

        const icon = card.querySelector(".team-card-icon");
        if (icon) {
          icon.classList.remove("border-white", "bg-white", "text-slate-900");
          icon.classList.add("border-slate-300", "bg-slate-800", "text-white");
        }
      });
    }

    function activateCard(card) {
      card.classList.add("border-slate-900", "bg-slate-50", "shadow-xl", "-translate-y-1");

      const icon = card.querySelector(".team-card-icon");
      if (icon) {
        icon.classList.remove("border-slate-300", "bg-slate-800", "text-white");
        icon.classList.add("border-white", "bg-white", "text-slate-900");
      }
    }

    function updateVisibleCards() {
      cards.forEach((card) => {
        const group = card.dataset.group;
        const matches = group === activeFilter;
        card.style.display = matches ? "flex" : "none";
      });
    }

    function renderMember(card) {
      if (!detailBio || !detailLocation || !detailLinkedin || !detailWebsite || !detailLanguages || !detailLogos) return;

      const bio = card.dataset.bio || "";
      const highlight = card.dataset.highlight || "";
      const location = card.dataset.location || "";
      const linkedin = card.dataset.linkedin || "#";
      const website = card.dataset.website || "#";
      const languages = JSON.parse(card.dataset.languages || "[]");
      const logos = JSON.parse(card.dataset.logos || "[]");

      if (highlight && bio.includes(highlight)) {
        const plain = bio.replace(highlight, "");
        detailBio.innerHTML = `${plain}<span class="font-semibold text-blue-700">${highlight}</span>`;
      } else {
        detailBio.textContent = bio;
      }

      detailLocation.innerHTML = `<span class="h-2 w-2 rounded-full bg-slate-300"></span>${location}`;
      detailLinkedin.setAttribute("href", linkedin);
      detailWebsite.setAttribute("href", website);

      detailLanguages.innerHTML = languages
        .map(
          (language) =>
            `<button type="button" class="rounded-full border border-slate-200 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-slate-700">${language}</button>`
        )
        .join("");

      detailLogos.innerHTML = logos
        .map(
          (logo) =>
            `<div class="flex h-12 items-center justify-center rounded-lg bg-white text-xs font-semibold text-slate-500 shadow-sm ring-1 ring-slate-200">${logo}</div>`
        )
        .join("");
    }

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        filterButtons.forEach((b) => {
          b.classList.remove("bg-slate-900", "text-white");
          b.classList.add("bg-slate-100", "text-slate-600");
        });

        button.classList.remove("bg-slate-100", "text-slate-600");
        button.classList.add("bg-slate-900", "text-white");

        activeFilter = button.dataset.filter || "";
        updateVisibleCards();

        const firstVisibleCard = [...cards].find((card) => card.style.display !== "none");

        resetActiveCards();

        if (firstVisibleCard) {
          activateCard(firstVisibleCard);
          renderMember(firstVisibleCard);
        }
      });
    });

    cards.forEach((card) => {
      card.addEventListener("click", () => {
        resetActiveCards();
        activateCard(card);
        renderMember(card);

        detail?.scrollIntoView({
          behavior: "smooth",
          block: "nearest",
        });
      });
    });

    updateVisibleCards();
  </script>
</Layout>