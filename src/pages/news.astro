---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import NewsCard from "../components/NewsCard.astro";

const allNews = await getCollection("news");

const sortedNews = [...allNews].sort(
  (a, b) => b.data.order - a.data.order
);

const normalizedTag = (value: string) =>
  value.trim().replace(/\s+/g, " ");

const tags = [
  ...new Set(
    sortedNews
      .map((item) => normalizedTag(item.data.tag))
      .filter(Boolean)
  ),
];

const filters = ["All Articles", ...tags];

const newsItems = sortedNews.map((item) => ({
  slug: item.slug,
  tag: normalizedTag(item.data.tag),
  tagNormalized: normalizedTag(item.data.tag).toLowerCase(),
  title: item.data.title,
  desc: item.data.description,
  date: item.data.date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }),
  time: item.data.minRead,
  image: item.data.image,
}));
---

<Layout title="BFC | News">
  <main>
    <section class="container-default py-20 md:py-28">
      <div class="max-w-5xl">
        <h1 class="max-w-4xl text-4xl font-extrabold leading-tight tracking-tight text-slate-900 dark:text-slate-100 md:text-6xl">
          What we have
          <br />
          been up to
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">
          Do not forget to
          <a href="#" class="text-blue-600 underline dark:text-blue-400"> subscribe </a>
          to our newsletter
        </p>
      </div>
    </section>

    <section class="sticky top-[73px] z-40 border-y border-slate-200 bg-white/90 py-4 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90">
      <div class="container-default flex flex-wrap items-center justify-between gap-4">
        <div id="filterButtons" class="flex flex-wrap gap-3">
          {filters.map((filter, index) => (
            <button
              type="button"
              data-filter={filter.toLowerCase()}
              class={`filter-btn rounded-full px-5 py-2 text-sm font-medium transition ${
                index === 0
                  ? "bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900"
                  : "bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
              }`}
            >
              {filter}
            </button>
          ))}
        </div>

        <div class="flex overflow-hidden rounded-full border border-slate-200 bg-slate-100 dark:border-slate-800 dark:bg-slate-900">
          <input
            id="searchInput"
            type="text"
            placeholder="Search articles"
            class="bg-transparent px-4 py-2 text-sm text-slate-900 outline-none placeholder:text-slate-400 dark:text-slate-100 dark:placeholder:text-slate-500"
          />

          <button class="bg-slate-900 px-5 text-sm font-medium text-white transition hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-200">
            Go
          </button>
        </div>
      </div>
    </section>

    <section class="container-default py-16">
      <div id="newsGrid" class="mt-12 grid gap-8 md:grid-cols-3">
        {newsItems.map((item) => (
          <div
            class="news-card"
            data-tag={item.tagNormalized}
            data-title={item.title.toLowerCase()}
          >
            <NewsCard
              slug={item.slug}
              tag={item.tag}
              title={item.title}
              desc={item.desc}
              date={item.date}
              time={item.time}
              image={item.image}
            />
          </div>
        ))}
      </div>
    </section>
  </main>

  <script>
    const buttons = document.querySelectorAll(".filter-btn");
    const cards = document.querySelectorAll(".news-card");
    const searchInput = document.getElementById("searchInput");

    let activeFilter = "all articles";

    function updateCards() {
      const query = searchInput.value.toLowerCase();

      cards.forEach((card) => {
        const tag = card.dataset.tag;
        const title = card.dataset.title;

        const matchesFilter =
          activeFilter === "all articles" || tag === activeFilter;

        const matchesSearch = title.includes(query);

        card.style.display = matchesFilter && matchesSearch ? "block" : "none";
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        buttons.forEach((b) => {
          b.classList.remove("bg-slate-900", "text-white", "dark:bg-slate-100", "dark:text-slate-900");
          b.classList.add("bg-slate-100", "text-slate-600", "dark:bg-slate-900", "dark:text-slate-300");
        });

        btn.classList.remove("bg-slate-100", "text-slate-600", "dark:bg-slate-900", "dark:text-slate-300");
        btn.classList.add("bg-slate-900", "text-white", "dark:bg-slate-100", "dark:text-slate-900");

        activeFilter = btn.dataset.filter;
        updateCards();
      });
    });

    searchInput?.addEventListener("input", updateCards);
  </script>
</Layout>