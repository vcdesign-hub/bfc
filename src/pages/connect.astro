---
import Layout from '../layouts/Layout.astro';

const contactCards = [
  {
    title: 'Startup Funding',
    desc: 'Tell us about what you are planning to do. Make us curious.',
    button: 'Apply for funding',
    href: 'https://forms.gle/fQakPfTVJmLLoMmA7',
  },
  {
    title: 'Job Opportunities',
    desc: 'Check out the jobs pages of our portfolio companies.',
    button: 'Check for jobs',
    href: '/portfolio',
  },
  {
    title: 'Media Inquiries',
    desc: 'For requests, opinions, or insights, reach out to Ben Horvath.',
    button: 'Contact Ben',
    href: 'mailto:ben@bfc.vc',
  },
  {
    title: 'Become an Investor',
    desc: 'Interested professional investors should contact Wolfgang Männel.',
    button: 'Contact Wolfgang',
    href: 'mailto:wolfgang@bfc.vc',
  },
  {
    title: 'Investor Portal',
    desc: 'All the documents, all the numbers at a glance for our investors only.',
    button: 'Login',
    href: 'https://investors.bfc.vc/',
  },
  {
    title: 'Investor Events',
    desc: 'For event and investor gatherings please contact Sagar.',
    button: 'Contact Sagar',
    href: 'mailto:sagar@bfc.vc',
  },
];
---

<Layout title="BFC | Connect">
<main>

<section class="container-default py-16 md:py-24">
  <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 md:text-6xl">
    Let's get in touch
  </h1>

  <p class="mt-4 max-w-2xl text-base text-slate-500">
    We look forward to getting to know you
  </p>
</section>


<section class="container-default pb-24">

<div class="mt-12 grid gap-8 md:grid-cols-3">

{contactCards.map((item) => (

<article class="flex h-full flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-soft">

<div class="flex flex-1 flex-col p-8">

<h3 class="text-2xl font-bold tracking-tight text-slate-900">
{item.title}
</h3>

<p class="mt-4 flex-1 text-sm leading-7 text-slate-600">
{item.desc}
</p>

<div class="mt-8 border-t border-slate-200 pt-6">

  <a
    href={item.href}
    class="btn-primary inline-flex items-center justify-center"
    target={item.href.startsWith('http') ? '_blank' : '_self'}
    rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
  >
    {item.button}
  </a>

</div>

</div>

</article>

))}

</div>

</section>

</main>
</Layout>