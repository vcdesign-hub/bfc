---
import Layout from '../layouts/Layout.astro';

const contactCards = [
  {
    title: 'Startup Funding',
    desc: 'Tell us about what you are planning to do. Make us curious.',
    button: 'Apply for funding',
    href: 'https://forms.gle/fQakPfTVJmLLoMmA7',
  },
  {
    title: 'Job Opportunities',
    desc: 'Check out the jobs pages of our portfolio companies.',
    button: 'Check for jobs',
    href: '/portfolio',
  },
  {
    title: 'Media Inquiries',
    desc: 'For requests, opinions, or insights, reach out to Ben Horvath.',
    button: 'Contact Ben',
    href: 'mailto:ben@bfc.vc',
  },
  {
    title: 'Become an Investor',
    desc: 'Interested professional investors should contact Wolfgang Männel.',
    button: 'Contact Wolfgang',
    href: 'mailto:wolfgang@bfc.vc',
  },
  {
    title: 'Investor Portal',
    desc: 'All the documents, all the numbers at a glance for our investors only.',
    button: 'Login',
    href: 'https://investors.bfc.vc/',
  },
  {
    title: 'Investor Events',
    desc: 'For event and investor gatherings please contact Sagar.',
    button: 'Contact Sagar',
    href: 'mailto:sagar@bfc.vc',
  },
];
---

<Layout title="BFC | Connect">
  <main>
    <section class="container-default py-16 sm:py-20 md:py-24">
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100 sm:text-5xl md:text-6xl">
        Let's get in touch
      </h1>

      <p class="mt-4 max-w-2xl text-base leading-7 text-slate-500 dark:text-slate-400 sm:text-lg sm:leading-8">
        We look forward to getting to know you
      </p>
    </section>

    <section class="container-default pb-16 sm:pb-20 md:pb-24">
      <div class="mt-8 grid gap-6 sm:mt-10 sm:gap-8 [@media(min-width:540px)]:grid-cols-2 lg:!grid-cols-3">
        {contactCards.map((item) => (
          <article class="flex h-full flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-soft dark:border-slate-900 dark:bg-slate-900/50">
            <div class="flex flex-1 flex-col p-6 sm:p-7 lg:p-8">
              <h3 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
                {item.title}
              </h3>

              <p class="mt-4 flex-1 text-sm leading-7 text-slate-600 dark:text-slate-300">
                {item.desc}
              </p>

              <div class="mt-8 border-t border-slate-200 pt-6 dark:border-slate-800">
                <a
                  href={item.href}
                  class="inline-flex w-full items-center justify-center rounded-full bg-slate-900 px-5 py-2 text-sm font-medium text-white transition hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-200 sm:w-auto"
                  target={item.href.startsWith('http') ? '_blank' : '_self'}
                  rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  {item.button}
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>