---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const articles = await getCollection("news");

  return articles.map((article) => ({
    params: { slug: article.slug },
  }));
}

const slug = Astro.params.slug;

if (!slug) {
  throw new Error("Missing news slug.");
}

const entry = await getEntry("news", slug);

if (!entry) {
  throw new Error(`News entry not found for slug: ${slug}`);
}

const { Content } = await render(entry);

const formattedDate = entry.data.date.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<Layout title={`BFC | ${entry.data.title}`}>
  <main>
    <section class="container-default py-16 md:py-24">
      <div class="mx-auto max-w-4xl">
        <p class="text-sm font-semibold text-blue-600">
          {entry.data.tag}
        </p>
    
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 md:text-6xl">
          {entry.data.title}
        </h1>
    
        <p class="mt-4 max-w-3xl text-base leading-7 text-slate-500">
          {entry.data.description}
        </p>
    
        <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-slate-400">
          <span>{formattedDate}</span>
          <span>{entry.data.minRead}</span>
        </div>
    
        <img
          src={entry.data.image}
          alt={entry.data.title}
          class="mt-10 w-full rounded-3xl border border-slate-200 object-cover shadow-soft"
        />
      </div>
    </section>

    <section class="container-default pb-24">
      <div class="mx-auto max-w-4xl">
        <article class="prose prose-slate news-article max-w-none">
          <Content />
        </article>
      </div>
    </section>
  </main>
</Layout>