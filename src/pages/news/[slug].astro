---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const articles = await getCollection("news");

  return articles.map((article) => ({
    params: { slug: article.slug },
  }));
}

const slug = Astro.params.slug;

if (!slug) {
  throw new Error("Missing news slug.");
}

const entry = await getEntry("news", slug);

if (!entry) {
  throw new Error(`News entry not found for slug: ${slug}`);
}

const { Content } = await render(entry);

const formattedDate = entry.data.date.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<Layout title={`BFC | ${entry.data.title}`}>
  <main>
    <section class="container-default py-16 md:py-24">
      <div class="mx-auto max-w-4xl">
        <p class="text-sm font-semibold text-blue-600 dark:text-blue-400">
          {entry.data.tag}
        </p>

        <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100 md:text-6xl">
          {entry.data.title}
        </h1>

        <p class="mt-4 max-w-3xl text-base leading-7 text-slate-500 dark:text-slate-400">
          {entry.data.description}
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-slate-400 dark:text-slate-500">
          <span>{formattedDate}</span>
          <span>{entry.data.minRead}</span>
        </div>

        <img
          src={entry.data.image}
          alt={entry.data.title}
          class="mt-10 w-full rounded-3xl border border-slate-200 object-cover shadow-soft dark:border-slate-800"
        />
      </div>
    </section>

    <section class="container-default pb-24">
      <div class="mx-auto max-w-4xl">
        <article class="news-article prose prose-slate max-w-none dark:prose-invert">
          <Content />
        </article>
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  .news-article h1,
  .news-article h2,
  .news-article h3,
  .news-article h4,
  .news-article h5,
  .news-article h6 {
    color: rgb(15 23 42);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .news-article p,
  .news-article li {
    color: rgb(71 85 105);
    line-height: 2;
  }

  .news-article strong {
    color: rgb(15 23 42);
  }

  .news-article a {
    color: rgb(37 99 235);
    text-decoration: underline;
  }

  .news-article blockquote {
    color: rgb(71 85 105);
    border-left-color: rgb(226 232 240);
  }

  .news-article hr {
    border-color: rgb(226 232 240);
  }

  .news-article code {
    color: rgb(15 23 42);
  }

  .news-article pre {
    background: rgb(248 250 252);
    color: rgb(15 23 42);
    border-radius: 1rem;
  }

  .news-article img {
    border-radius: 1.5rem;
    border: 1px solid rgb(226 232 240);
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.06);
  }

  .dark .news-article h1,
  .dark .news-article h2,
  .dark .news-article h3,
  .dark .news-article h4,
  .dark .news-article h5,
  .dark .news-article h6,
  .dark .news-article strong,
  .dark .news-article code {
    color: rgb(241 245 249);
  }

  .dark .news-article p,
  .dark .news-article li {
    color: rgb(226 232 240);
  }

  .dark .news-article a {
    color: rgb(96 165 250);
  }

  .dark .news-article blockquote {
    color: rgb(203 213 225);
    border-left-color: rgb(30 41 59);
  }

  .dark .news-article hr {
    border-color: rgb(30 41 59);
  }

  .dark .news-article pre {
    background: rgb(15 23 42);
    color: rgb(241 245 249);
  }

  .dark .news-article img {
    border-color: rgb(30 41 59);
  }
</style>