---
interface Props {
  id?: string;
  quote: string;
  name: string;
  role: string;
  company?: string;
  companyLabel?: string;
  logo?: string;
  image: string;
  imageAlt?: string;
}

const {
  id,
  quote,
  name,
  role,
  company,
  companyLabel = "Portfolio company",
  logo,
  image,
  imageAlt = name,
} = Astro.props;
---

<article
  id={id}
  class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-soft dark:border-slate-800 dark:bg-slate-900"
>
  <div class="grid items-center gap-10 p-8 md:grid-cols-[minmax(0,1.45fr)_220px] md:p-10 lg:grid-cols-[minmax(0,1.6fr)_280px] lg:p-12">
    <div class="flex h-full flex-col">
      <div class="mb-8 flex items-center gap-3">
        <div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-xl bg-slate-100 ring-1 ring-slate-200 dark:bg-slate-800 dark:ring-slate-700">
          <img
            data-logo
            src={logo}
            alt={`${company ?? name} logo`}
            class="h-full w-full object-contain"
          />
        </div>

        <div>
          <p data-company class="text-base font-semibold text-slate-900 dark:text-slate-100">
            {company}
          </p>
          <p class="text-sm text-slate-500 dark:text-slate-400">{companyLabel}</p>
        </div>
      </div>

      <blockquote
        data-quote
        class="max-w-3xl text-2xl font-medium leading-tight tracking-tight text-slate-900 dark:text-slate-100 md:text-3xl"
      >
        {quote}
      </blockquote>

      <div class="mt-8 border-t border-slate-200 pt-6 dark:border-slate-800">
        <p data-name class="text-base font-semibold text-slate-900 dark:text-slate-100">
          {name}
        </p>
        <p data-role class="mt-1 text-sm leading-6 text-slate-500 dark:text-slate-400">
          {role}
        </p>
      </div>
    </div>

    <div class="mx-auto w-full max-w-[280px]">
      <div class="aspect-square overflow-hidden rounded-full border border-slate-200 bg-slate-100 shadow-soft dark:border-slate-800 dark:bg-slate-800">
        <img
          data-image
          src={image}
          alt={imageAlt}
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </div>
</article>