---
interface Props {
  slug: string;
  tag: string;
  title: string;
  desc: string;
  date: string;
  time: string;
  image: string;
}

const { slug, tag, title, desc, date, time, image } = Astro.props;
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-soft transition hover:shadow-lg dark:border-slate-900 dark:bg-slate-900/50">
  <a
    href={`/news/${slug}`}
    aria-label={`Read ${title}`}
    class="absolute inset-0 z-10"
  ></a>

  <img
    src={image}
    alt={title}
    class="h-56 w-full object-cover transition duration-300 group-hover:scale-[1.02]"
  />

  <div class="flex flex-1 flex-col p-8">
    <span class="w-fit rounded-full bg-slate-900 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white dark:bg-slate-100 dark:text-slate-900">
      {tag}
    </span>

    <h3 class="mt-5 text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
      {title}
    </h3>

    <p class="mt-4 flex-1 text-sm leading-7 text-slate-600 dark:text-slate-300">
      {desc}
    </p>

    <div class="mt-8 flex items-center justify-between border-t border-slate-200 pt-6 text-xs text-slate-400 dark:border-slate-800 dark:text-slate-500">
      <span>{date}</span>
      <span>{time}</span>
    </div>
  </div>
</article>