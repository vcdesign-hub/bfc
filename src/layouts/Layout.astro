---
import '../styles/global.css';

type Props = {
  title?: string;
};

const { title = 'BFC' } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Team', href: '/team' },
  { label: 'News', href: '/news' },
  { label: 'Snapshots', href: '/snapshots' },
  { label: 'Connect', href: '/connect' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta
      name="description"
      content="BFC invests in founders building the future of the internet."
    />

    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

      if (storedTheme === 'dark' || (!storedTheme && systemPrefersDark)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen bg-white font-sans text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <header class="sticky top-0 z-50 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90">
      <div class="container-default flex items-center justify-between py-4">
        <a href="/" class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100">
          BFC
        </a>

        <nav class="hidden items-center gap-8 md:flex">
          {navItems.map((item) => {
            const isActive =
              item.href !== '#' &&
              (currentPath === item.href ||
                (item.href !== '/' && currentPath.startsWith(item.href)));

            return (
              <a
                href={item.href}
                class:list={[
                  'text-sm font-medium transition',
                  isActive
                    ? 'border-b-2 border-slate-900 pb-1 text-slate-900 dark:border-slate-100 dark:text-slate-100'
                    : 'text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100',
                ]}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <div class="flex items-center gap-2">
          <button
            id="theme-toggle"
            type="button"
            aria-label="Theme toggle"
            class="rounded-full p-2 text-slate-700 transition hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"
          >
            <!-- MOON -->
            <svg
              id="theme-toggle-moon"
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
              />
            </svg>

            <!-- SUN -->
            <svg
              id="theme-toggle-sun"
              class="hidden h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M12 3v2.25M12 18.75V21M21 12h-2.25M5.25 12H3M18.364 5.636l-1.591 1.591M7.227 16.773l-1.591 1.591M18.364 18.364l-1.591-1.591M7.227 7.227 5.636 5.636M15.75 12A3.75 3.75 0 1 1 8.25 12a3.75 3.75 0 0 1 7.5 0Z"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
              />
            </svg>
          </button>

          <button
            type="button"
            aria-label="Search"
            class="rounded-full p-2 text-slate-700 transition hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
              />
            </svg>
          </button>

          <button
            id="mobile-menu-toggle"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="rounded-full p-2 text-slate-700 transition hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 md:hidden"
          >
            <svg
              id="mobile-menu-open-icon"
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M4 6h16M4 12h16M4 18h16"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
              />
            </svg>

            <svg
              id="mobile-menu-close-icon"
              class="hidden h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M6 6l12 12M18 6L6 18"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
              />
            </svg>
          </button>
        </div>
      </div>

      <div
        id="mobile-menu"
        class="hidden border-t border-slate-200 bg-white/95 dark:border-slate-800 dark:bg-slate-950/95 md:hidden"
      >
        <nav class="container-default flex flex-col py-4">
          {navItems.map((item) => {
            const isActive =
              item.href !== '#' &&
              (currentPath === item.href ||
                (item.href !== '/' && currentPath.startsWith(item.href)));

            return (
              <a
                href={item.href}
                class:list={[
                  'py-3 text-sm font-medium transition',
                  isActive
                    ? 'text-slate-900 dark:text-slate-100'
                    : 'text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100',
                ]}
              >
                {item.label}
              </a>
            );
          })}
        </nav>
      </div>
    </header>

    <slot />

    <footer class="bg-slate-50 py-20 dark:bg-slate-900/40">
      <div class="container-default">
        <div class="grid gap-14 lg:grid-cols-2">
          <div>
            <span class="mb-6 block text-4xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100">
              BFC
            </span>

            <p class="max-w-xl text-base leading-7 text-slate-600 dark:text-slate-400">
              Driven by empathy and relentlessness, we look beyond surface level presentations
              to uncover what truly fuels founders, their passions, challenges, immigrant
              backgrounds, and often crazy childhoods.
            </p>

            <div class="mt-8 flex gap-3">
              <a
                href="https://www.linkedin.com/company/blockchain-founders-capital/about/"
                aria-label="LinkedIn"
                class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-900 bg-slate-900 text-white transition hover:-translate-y-1 hover:bg-white hover:text-slate-900 dark:border-slate-200 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-900 dark:hover:text-white"
              >
                <i class="fa-brands fa-linkedin-in text-[16px]"></i>
              </a>

              <a
                href="https://twitter.com/BFC_VC"
                aria-label="X"
                class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-900 bg-slate-900 text-white transition hover:-translate-y-1 hover:bg-white hover:text-slate-900 dark:border-slate-200 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-900 dark:hover:text-white"
              >
                <i class="fa-brands fa-x-twitter text-[16px]"></i>
              </a>

              <a
                href="https://www.crunchbase.com/organization/blockchain-founders-capital"
                aria-label="Crunchbase"
                class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-900 bg-slate-900 text-[11px] font-semibold tracking-[0.08em] text-white transition hover:-translate-y-1 hover:bg-white hover:text-slate-900 dark:border-slate-200 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-900 dark:hover:text-white"
              >
                CB
              </a>

              <a
                href="https://www.youtube.com/@blockfoucapital"
                aria-label="YouTube"
                class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-900 bg-slate-900 text-white transition hover:-translate-y-1 hover:bg-white hover:text-slate-900 dark:border-slate-200 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-900 dark:hover:text-white"
              >
                <i class="fa-brands fa-youtube text-[16px]"></i>
              </a>

              <a
                href="https://www.bfc.vc/rss-feed"
                aria-label="RSS"
                class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-900 bg-slate-900 text-white transition hover:-translate-y-1 hover:bg-white hover:text-slate-900 dark:border-slate-200 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-900 dark:hover:text-white"
              >
                <i class="fa-solid fa-rss text-[16px]"></i>
              </a>
            </div>
          </div>

          <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-soft dark:border-slate-800 dark:bg-slate-950">
            <h3 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
              Subscribe to our Newsletter
            </h3>

            <form
              id="mc-embedded-subscribe-form"
              name="mc-embedded-subscribe-form"
              class="mt-6 space-y-4"
            >
              <div class="grid gap-4 md:grid-cols-2">
                <input
                  type="text"
                  name="FNAME"
                  id="mce-FNAME"
                  placeholder="First Name"
                  required
                  minlength="2"
                  autocomplete="given-name"
                  class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition focus:border-slate-900 focus:bg-white invalid:border-red-500 invalid:text-red-600 focus:invalid:border-red-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-slate-300 dark:focus:bg-slate-950 dark:invalid:border-red-400"
                />

                <input
                  type="text"
                  name="LNAME"
                  id="mce-LNAME"
                  placeholder="Last Name"
                  required
                  minlength="2"
                  autocomplete="family-name"
                  class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition focus:border-slate-900 focus:bg-white invalid:border-red-500 invalid:text-red-600 focus:invalid:border-red-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-slate-300 dark:focus:bg-slate-950 dark:invalid:border-red-400"
                />
              </div>

              <input
                type="email"
                name="EMAIL"
                id="mce-EMAIL"
                placeholder="Email"
                required
                autocomplete="email"
                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition focus:border-slate-900 focus:bg-white invalid:border-red-500 invalid:text-red-600 focus:invalid:border-red-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-slate-300 dark:focus:bg-slate-950 dark:invalid:border-red-400"
              />

              <input type="hidden" name="tags" value="4889172" />

              <div aria-hidden="true" class="absolute left-[-5000px]">
                <input
                  type="text"
                  name="b_b24a4a180be6b26d2e7ed0cdb_aab85c465a"
                  tabindex="-1"
                  value=""
                />
              </div>

              <button
                type="submit"
                name="subscribe"
                id="mc-embedded-subscribe"
                class="w-full rounded-xl bg-slate-900 px-6 py-4 font-semibold text-white transition hover:opacity-90 dark:bg-slate-100 dark:text-slate-900"
              >
                Send
              </button>
            </form>
          </div>
        </div>

        <div class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-slate-200 pt-8 text-sm text-slate-500 md:flex-row md:items-center dark:border-slate-800 dark:text-slate-400">
          <div class="flex flex-wrap gap-6">
            <a href="/legal-notice" class="transition hover:text-slate-900 dark:hover:text-slate-100">Legal Notice</a>
            <a href="/privacy-policy" class="transition hover:text-slate-900 dark:hover:text-slate-100">Privacy Policy</a>
            <a href="/sfdr-statement" class="transition hover:text-slate-900 dark:hover:text-slate-100">SFDR Statement</a>
          </div>

          <p>© 2026 Blockchain Founders Capital Management GmbH</p>
        </div>
      </div>
    </footer>

    <div
      id="newsletter-popup"
      class="fixed inset-0 z-[60] hidden items-center justify-center bg-slate-950/60 px-4 backdrop-blur-sm"
    >
      <div class="relative w-full max-w-5xl overflow-hidden rounded-3xl bg-white shadow-soft dark:border-slate-800 dark:bg-slate-950">
        <button
          type="button"
          id="newsletter-popup-close"
          aria-label="Close newsletter popup"
          class="absolute right-5 top-5 z-10 rounded-full p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 dark:text-slate-500 dark:hover:bg-slate-800 dark:hover:text-slate-200"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              d="M6 6l12 12M18 6L6 18"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            />
          </svg>
        </button>

        <div class="grid md:grid-cols-[1.05fr_1.35fr]">
          <div class="relative hidden min-h-[560px] items-center justify-center overflow-hidden md:flex">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-500 via-blue-600 to-slate-900"></div>
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.15),transparent_60%)]"></div>

            <div class="relative z-[1] flex items-center justify-center">
              <span class="text-7xl font-extrabold tracking-tight text-white md:text-8xl">
                BFC
              </span>
            </div>
          </div>

          <div class="p-8 md:p-12 lg:p-14">
            <div class="max-w-xl">
              <h3 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100 md:text-5xl">
                Subscribe to our Newsletter
              </h3>

              <p class="mt-6 max-w-lg text-lg leading-8 text-slate-600 dark:text-slate-300">
                Stay in the loop with updates on investments, portfolio companies, founder stories, and what we are building.
              </p>

              <form
                id="newsletter-popup-form"
                name="newsletter-popup-form"
                class="mt-10 space-y-4"
              >
                <div class="grid gap-4 md:grid-cols-2">
                  <input
                    type="text"
                    name="FNAME"
                    id="popup-FNAME"
                    placeholder="First Name"
                    required
                    minlength="2"
                    autocomplete="given-name"
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 px-5 py-4 text-slate-900 outline-none transition focus:border-slate-900 focus:bg-white invalid:border-red-500 invalid:text-red-600 focus:invalid:border-red-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-slate-300 dark:focus:bg-slate-950 dark:invalid:border-red-400"
                  />

                  <input
                    type="text"
                    name="LNAME"
                    id="popup-LNAME"
                    placeholder="Last Name"
                    required
                    minlength="2"
                    autocomplete="family-name"
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 px-5 py-4 text-slate-900 outline-none transition focus:border-slate-900 focus:bg-white invalid:border-red-500 invalid:text-red-600 focus:invalid:border-red-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-slate-300 dark:focus:bg-slate-950 dark:invalid:border-red-400"
                  />
                </div>

                <input
                  type="email"
                  name="EMAIL"
                  id="popup-EMAIL"
                  placeholder="Email"
                  required
                  autocomplete="email"
                  class="w-full rounded-xl border border-slate-200 bg-slate-50 px-5 py-4 text-slate-900 outline-none transition focus:border-slate-900 focus:bg-white invalid:border-red-500 invalid:text-red-600 focus:invalid:border-red-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-slate-300 dark:focus:bg-slate-950 dark:invalid:border-red-400"
                />

                <input type="hidden" name="tags" value="4889172" />

                <div aria-hidden="true" class="absolute left-[-5000px]">
                  <input
                    type="text"
                    name="b_b24a4a180be6b26d2e7ed0cdb_aab85c465a"
                    tabindex="-1"
                    value=""
                  />
                </div>

                <button
                  type="submit"
                  class="w-full rounded-xl bg-slate-900 px-6 py-4 font-semibold text-white transition hover:opacity-90 dark:bg-slate-100 dark:text-slate-900"
                >
                  Send
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div
      id="newsletter-success"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/60 px-4 backdrop-blur-sm"
    >
      <div class="w-full max-w-md rounded-3xl border border-slate-200 bg-white p-8 shadow-soft dark:border-slate-800 dark:bg-slate-900">
        <h3 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
          Almost finished
        </h3>

        <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">
          Please check your inbox and confirm your email subscription.
        </p>

        <button
          type="button"
          id="newsletter-success-close"
          class="mt-6 w-full rounded-xl bg-slate-900 px-6 py-4 font-semibold text-white transition hover:opacity-90 dark:bg-slate-100 dark:text-slate-900"
        >
          Close
        </button>
      </div>
    </div>

    <script is:inline>
      const themeToggle = document.getElementById('theme-toggle');
const themeToggleSun = document.getElementById('theme-toggle-sun');
const themeToggleMoon = document.getElementById('theme-toggle-moon');

function syncThemeIcon() {
  const isDark = document.documentElement.classList.contains('dark');

  if (isDark) {
    themeToggleSun?.classList.remove('hidden');
    themeToggleMoon?.classList.add('hidden');
  } else {
    themeToggleSun?.classList.add('hidden');
    themeToggleMoon?.classList.remove('hidden');
  }
}

syncThemeIcon();

themeToggle?.addEventListener('click', () => {
  const isDark = document.documentElement.classList.toggle('dark');
  localStorage.setItem('theme', isDark ? 'dark' : 'light');
  syncThemeIcon();
});
    </script>

    <script is:inline>
      const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileMenuOpenIcon = document.getElementById('mobile-menu-open-icon');
      const mobileMenuCloseIcon = document.getElementById('mobile-menu-close-icon');

      function closeMobileMenu() {
        if (!mobileMenu || !mobileMenuToggle || !mobileMenuOpenIcon || !mobileMenuCloseIcon) return;

        mobileMenu.classList.add('hidden');
        mobileMenuToggle.setAttribute('aria-expanded', 'false');
        mobileMenuOpenIcon.classList.remove('hidden');
        mobileMenuCloseIcon.classList.add('hidden');
      }

      function openMobileMenu() {
        if (!mobileMenu || !mobileMenuToggle || !mobileMenuOpenIcon || !mobileMenuCloseIcon) return;

        mobileMenu.classList.remove('hidden');
        mobileMenuToggle.setAttribute('aria-expanded', 'true');
        mobileMenuOpenIcon.classList.add('hidden');
        mobileMenuCloseIcon.classList.remove('hidden');
      }

      mobileMenuToggle?.addEventListener('click', () => {
        if (!mobileMenu) return;

        const isOpen = !mobileMenu.classList.contains('hidden');

        if (isOpen) {
          closeMobileMenu();
        } else {
          openMobileMenu();
        }
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) {
          closeMobileMenu();
        }
      });

      mobileMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          closeMobileMenu();
        });
      });
    </script>

    <script is:inline>
      const newsletterForm = document.getElementById('mc-embedded-subscribe-form');
      const newsletterPopupForm = document.getElementById('newsletter-popup-form');
      const newsletterSuccessModal = document.getElementById('newsletter-success');
      const newsletterSuccessCloseButton = document.getElementById('newsletter-success-close');
      const newsletterPopup = document.getElementById('newsletter-popup');
      const newsletterPopupCloseButton = document.getElementById('newsletter-popup-close');

      const newsletterStorageKeys = {
        subscribed: 'newsletterPopupSubscribed',
        shownSession: 'newsletterPopupShownSession',
      };

      function openNewsletterSuccessModal() {
        if (!newsletterSuccessModal) return;
        newsletterSuccessModal.classList.remove('hidden');
        newsletterSuccessModal.classList.add('flex');
      }

      function closeNewsletterSuccessModal() {
        if (!newsletterSuccessModal) return;
        newsletterSuccessModal.classList.add('hidden');
        newsletterSuccessModal.classList.remove('flex');
      }

      function openNewsletterPopup() {
        if (!newsletterPopup) return;
        newsletterPopup.classList.remove('hidden');
        newsletterPopup.classList.add('flex');
        document.body.classList.add('overflow-hidden');
        sessionStorage.setItem(newsletterStorageKeys.shownSession, 'true');
      }

      function closeNewsletterPopup() {
        if (!newsletterPopup) return;
        newsletterPopup.classList.add('hidden');
        newsletterPopup.classList.remove('flex');
        document.body.classList.remove('overflow-hidden');
      }

      function shouldShowNewsletterPopup() {
        const isSubscribed = localStorage.getItem(newsletterStorageKeys.subscribed) === 'true';
        if (isSubscribed) return false;

        const shownThisSession = sessionStorage.getItem(newsletterStorageKeys.shownSession) === 'true';
        if (shownThisSession) return false;

        const path = window.location.pathname;
        const blockedPaths = ['/legal-notice', '/privacy-policy', '/sfdr-statement'];
        if (blockedPaths.includes(path)) return false;

        return true;
      }

      async function submitNewsletterForm(formElement) {
        const formData = new FormData(formElement);

        await fetch(
          'https://bfc.us8.list-manage.com/subscribe/post?u=b24a4a180be6b26d2e7ed0cdb&id=aab85c465a&f_id=007765e0f0',
          {
            method: 'POST',
            body: formData,
            mode: 'no-cors',
          }
        );
      }

      function attachNewsletterFormHandler(formElement, onSuccess) {
        if (!(formElement instanceof HTMLFormElement)) return;

        formElement.addEventListener('submit', async function (e) {
          e.preventDefault();

          if (!formElement.checkValidity()) {
            formElement.reportValidity();
            return;
          }

          try {
            await submitNewsletterForm(formElement);
            onSuccess();
            formElement.reset();
          } catch (error) {
            console.error(error);
            alert('Something went wrong. Please try again.');
          }
        });
      }

      attachNewsletterFormHandler(newsletterForm, function () {
        openNewsletterSuccessModal();
      });

      attachNewsletterFormHandler(newsletterPopupForm, function () {
        localStorage.setItem(newsletterStorageKeys.subscribed, 'true');
        closeNewsletterPopup();
        openNewsletterSuccessModal();
      });

      if (newsletterSuccessCloseButton) {
        newsletterSuccessCloseButton.addEventListener('click', closeNewsletterSuccessModal);
      }

      if (newsletterSuccessModal) {
        newsletterSuccessModal.addEventListener('click', function (e) {
          if (e.target === newsletterSuccessModal) {
            closeNewsletterSuccessModal();
          }
        });
      }

      if (newsletterPopupCloseButton) {
        newsletterPopupCloseButton.addEventListener('click', function () {
          closeNewsletterPopup();
        });
      }

      if (newsletterPopup) {
        newsletterPopup.addEventListener('click', function (e) {
          if (e.target === newsletterPopup) {
            closeNewsletterPopup();
          }
        });
      }

      if (shouldShowNewsletterPopup()) {
        let popupShown = false;

        const showPopupOnce = () => {
          if (popupShown || !shouldShowNewsletterPopup()) return;
          popupShown = true;
          openNewsletterPopup();
          window.removeEventListener('scroll', handlePopupScroll);
        };

        const handlePopupScroll = () => {
          const scrollTop = window.scrollY || window.pageYOffset;
          const documentHeight = document.documentElement.scrollHeight - window.innerHeight;

          if (documentHeight <= 0) return;

          const scrollProgress = scrollTop / documentHeight;

          if (scrollProgress >= 0.4) {
            showPopupOnce();
          }
        };

        window.addEventListener('scroll', handlePopupScroll, { passive: true });

        window.setTimeout(() => {
          showPopupOnce();
        }, 10000);
      }
    </script>
  </body>
</html>