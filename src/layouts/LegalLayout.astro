---
import Layout from "./Layout.astro";

type Props = {
  title?: string;
};

const { title = "BFC" } = Astro.props;
---

<Layout title={title}>
  <main class="bg-white">
    <section class="container-default py-16 md:py-24">
      <div class="max-w-4xl">
        <article class="legal-content">
          <slot />
        </article>
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  .legal-content h1 {
    font-size: 2.5rem;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: rgb(15 23 42);
    margin-bottom: 1.5rem;
  }

  .legal-content h2 {
    font-size: 1.5rem;
    line-height: 1.3;
    font-weight: 700;
    color: rgb(15 23 42);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .legal-content h3 {
    font-size: 1.125rem;
    line-height: 1.5;
    font-weight: 700;
    color: rgb(15 23 42);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .legal-content p {
    font-size: 1rem;
    line-height: 1.9;
    color: rgb(71 85 105);
    margin-bottom: 1rem;
  }

  .legal-content ul,
  .legal-content ol {
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    color: rgb(71 85 105);
  }

  .legal-content li {
    margin-bottom: 0.75rem;
    line-height: 1.8;
  }

  .legal-content a {
    color: rgb(37 99 235);
    text-decoration: none;
  }

  .legal-content a:hover {
    text-decoration: underline;
  }

  .legal-content strong {
    font-weight: 700;
    color: rgb(15 23 42);
  }

  .legal-content hr {
    border: 0;
    border-top: 1px solid rgb(226 232 240);
    margin: 2rem 0;
  }
</style>